---
import Campaign from "@layouts/Campaign.astro";
import PageHeader from "@components/PageHeader.astro";
import StatRow from "@components/StatRow.astro";
import VerdictChip from "@components/VerdictChip.astro";
import KillBadge from "@components/KillBadge.astro";
import EvidenceChip from "@components/EvidenceChip.astro";
import LedgerStrip from "@components/islands/LedgerStrip.tsx";
import AuditWalkthrough from "@components/islands/AuditWalkthrough.tsx";
import HypothesisBoard from "@components/islands/HypothesisBoard.tsx";
import ledger from "@data/ledger.json";
import cards from "@data/cards.json";
import summary from "@data/campaign.json";
import chiSpec from "@data/specs/campaign-chi-drift.json";
import manifest from "@data/specs/manifest.json";
import costRecord from "@data/walkthrough-cost-record.json";

const stripRows = ledger.map((r) => ({
  card: r.card,
  slug: r.slug,
  h: r.hypothesis_id,
  statement: r.statement,
  metric: r.metric,
  comparator: r.comparator,
  threshold: r.threshold,
  prob: r.registered_prob,
  observed: r.observed,
  outcome: r.outcome as "confirmed" | "refuted" | "inconclusive",
  kill: r.kill_id,
}));

const boardRows = ledger.map((r) => ({
  card: r.card,
  slug: r.slug,
  hypothesis_id: r.hypothesis_id,
  statement: r.statement,
  metric: r.metric,
  comparator: r.comparator,
  threshold: r.threshold,
  registered_prob: r.registered_prob,
  observed: r.observed,
  outcome: r.outcome as "confirmed" | "refuted" | "inconclusive",
  kill_id: r.kill_id,
  science: r.science,
}));

const chi = cards.find((c) => c.id === "chi-drift")!;
const cal = cards.find((c) => c.id === "cal-transfer")!;

const steps = [
  {
    id: "written",
    title: "A hypothesis is written down, with a comparator and a threshold",
    body: "Before any confirmatory compute ran, each card named its metric, its comparator, and its threshold. CHI-DRIFT registered chi_bon_spearman > 0.3 and assigned the call a pre-run probability of 0.6.",
    artifactLabel: "specs/frozen/campaign-chi-drift.json (fragment)",
    artifact: {
      id: chiSpec.spec.id,
      hypotheses: [chiSpec.spec.hypotheses[0]],
      science: chiSpec.spec.science,
      registered_probability: 0.6,
    },
  },
  {
    id: "frozen",
    title: "The specs are frozen",
    body: "All 27 specs were hashed and tagged before the run. The +dirty suffix on the git sha is itself disclosed. Every threshold predates the confirmatory evidence by construction.",
    artifactLabel: "specs/frozen/manifest.json (fragment)",
    artifact: {
      created_at: manifest.created_at,
      git_sha: manifest.git_sha,
      tag: manifest.tag,
      spec_hashes: [...manifest.spec_hashes.slice(0, 3), `… 24 more`],
    },
  },
  {
    id: "run",
    title: "The fleet runs, on metered time",
    body: `The confirmatory run cost $17.73 of metered H100 time across ten reward models. Every evidence record carries its own cost fields; this one is the single most expensive record in the store.`,
    artifactLabel: "one evidence record from the merged store (value elided)",
    artifact: costRecord,
  },
  {
    id: "adjudicated",
    title: "Adjudication happens by machinery",
    body: "The adjudicator compares each observed value against its frozen threshold and writes the verdict into the append-only store. CHI-DRIFT observed 0.9643 against its registered 0.3.",
    artifactLabel: `adjudication record ${chi.adjudication_ev} (fragment)`,
    artifact: {
      card: chi.card,
      outcomes: Object.fromEntries(
        chi.hypotheses.map((h) => [h.id, h.outcome]),
      ),
      metrics: Object.fromEntries(
        chi.hypotheses.map((h) => [h.metric, h.observed]),
      ),
      killed: false,
      evidence_id: chi.adjudication_ev,
    },
  },
  {
    id: "refuted",
    title: "Refutations are published with the same prominence",
    body: "CAL-TRANSFER observed 0.419 against its frozen 0.15 equivalence bound. K-transfer fired. The refutation runs through exactly the same machinery as every confirmation, and it leads the results document.",
    artifactLabel: `adjudication record ${cal.adjudication_ev} (fragment)`,
    artifact: {
      card: cal.card,
      outcomes: { "H-transfer": "refuted" },
      metrics: { max_abs_auc_difference: cal.hypotheses[0].observed },
      killed: true,
      killed_by: ["K-transfer"],
      evidence_id: cal.adjudication_ev,
    },
  },
];

const groups = [
  { verdict: "confirmed", label: "Confirmed" },
  { verdict: "refuted", label: "Refuted" },
  { verdict: "mixed", label: "Mixed" },
  { verdict: "inconclusive", label: "Inconclusive" },
] as const;

const fmt = (n: number | null): string => {
  if (n === null) return "–";
  if (Number.isInteger(n)) return String(n);
  const a = Math.abs(n);
  if (a !== 0 && (a < 1e-3 || a >= 1e4)) return n.toExponential(2);
  return String(Number(n.toPrecision(4)));
};

const headline = (card: (typeof cards)[number]) => {
  const h =
    card.hypotheses.find((x) => x.outcome !== "inconclusive") ??
    card.hypotheses[0];
  return h;
};
---

<Campaign
  title="The scored ledger · reward-lens"
  description="27 cards, 53 frozen hypotheses, 8 kills fired, and every threshold older than the evidence that judged it."
  ogImage="/og/campaign.png"
>
  <Fragment slot="breadcrumb">
    <a href="/">reward-lens</a>
    <span>Campaign</span>
  </Fragment>

  <PageHeader
    display
    eyebrow="the campaign"
    title="The scored ledger"
    lede="27 cards, 53 frozen hypotheses, 8 kills fired, and every threshold older than the evidence that judged it."
  />

  <section class="masthead-strip" aria-label="All 53 outcomes">
    <LedgerStrip client:load rows={stripRows} animate={false} />
    <p class="strip-caption">
      Predictions frozen 2026-07-18 at git <code>f93f4b5</code>; every
      threshold predates the confirmatory evidence by construction. One mark
      per hypothesis; notched marks fired a kill criterion.
    </p>
  </section>

  <StatRow
    stats={[
      { value: "53", label: "frozen hypotheses" },
      { value: "16 / 21 / 16", label: "confirmed / refuted / inconclusive" },
      { value: "27", label: "cards: 4 confirmed, 8 refuted, 7 mixed, 8 inconclusive" },
      { value: "8", label: "kill criteria fired" },
      { value: "$17.73", label: "metered H100 spend" },
    ]}
  />

  <section class="campaign-section" aria-labelledby="walkthrough-h">
    <h2 id="walkthrough-h">What pre-registration means here</h2>
    <p class="section-lede">
      Five steps, each showing the real artifact. Nothing below is a mockup.
    </p>
    <AuditWalkthrough client:visible steps={steps} />
  </section>

  <section class="campaign-section" aria-labelledby="board-h">
    <h2 id="board-h">The hypothesis board</h2>
    <p class="section-lede">
      Every frozen hypothesis with its registered prediction, the observed
      value, and the outcome. Filters and sorting are linkable.
    </p>
    <HypothesisBoard client:visible rows={boardRows} />
  </section>

  <section class="campaign-section" aria-labelledby="cards-h">
    <h2 id="cards-h">The 27 cards</h2>
    {
      groups.map((g) => (
        <div class="card-group">
          <h3 class="group-title">
            {g.label}
            <span class="group-count">
              {cards.filter((c) => c.verdict === g.verdict).length}
            </span>
          </h3>
          <ul class="card-rows">
            {cards
              .filter((c) => c.verdict === g.verdict)
              .map((c) => {
                const h = headline(c);
                return (
                  <li class="card-row">
                    <a class="card-link" href={`/campaign/${c.id}/`}>
                      <span class="card-row-id">{c.card}</span>
                      <span class="card-row-title">{c.title}</span>
                    </a>
                    <span class="card-row-detail">
                      {c.verdict === "inconclusive" ? (
                        <code class="card-row-metric">
                          {h.metric} {h.comparator} {fmt(h.threshold)} · not
                          measured
                        </code>
                      ) : (
                        <>
                          <code class="card-row-metric">
                            {h.metric} {h.comparator} {fmt(h.threshold)}
                          </code>
                          <EvidenceChip
                            value={h.observed!}
                            trust="A"
                            evidenceId={c.adjudication_ev}
                            observable={h.metric}
                            subject={c.card}
                            threshold={`${h.comparator} ${fmt(h.threshold)}`}
                          />
                        </>
                      )}
                      <VerdictChip verdict={c.verdict} compact />
                      {c.kill_fired && <KillBadge kill={c.kill_fired} />}
                    </span>
                  </li>
                );
              })}
          </ul>
        </div>
      ))
    }
  </section>

  <section class="campaign-section honesty" aria-labelledby="honesty-h">
    <h2 id="honesty-h">The honest engineering note</h2>
    <p>
      Eight cards came back inconclusive for engineering reasons, not
      scientific ones: two hit a permission error in subject resolution, and
      six were missing an intermediate because an arc never ran or its shard
      never merged. The campaign runbook can re-run them against the same
      frozen specs. Eight other cards were frozen under explicit low-power
      acceptances, recorded in the freeze manifest before any evidence
      existed; each affected card page discloses its power and minimum
      detectable effect. The full accounting is on the
      <a href="/campaign/method/">method page</a>.
    </p>
  </section>
</Campaign>

<style>
  .masthead-strip {
    margin: var(--sp-8) 0;
  }
  .strip-caption {
    margin: var(--sp-3) 0 0;
    font-size: var(--text-sm);
    color: var(--ink-3);
    max-width: var(--measure-prose);
  }

  .campaign-section {
    margin-top: var(--sp-16);
  }
  .campaign-section h2 {
    font-size: var(--text-2xl);
    font-weight: 600;
    margin: 0 0 var(--sp-2);
  }
  .section-lede {
    color: var(--ink-2);
    margin: 0 0 var(--sp-6);
    max-width: var(--measure-prose);
  }

  .card-group {
    margin-top: var(--sp-8);
  }
  .group-title {
    font-size: var(--text-lg);
    font-weight: 600;
    margin: 0 0 var(--sp-3);
    display: flex;
    gap: var(--sp-2);
    align-items: baseline;
  }
  .group-count {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--ink-3);
  }
  .card-rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .card-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-4);
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--line);
    padding: var(--sp-3) 0;
  }
  .card-row:first-child {
    border-top: 1px solid var(--line);
  }
  .card-link {
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 16rem;
    flex: 1;
  }
  .card-row-id {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-3);
  }
  .card-row-title {
    color: var(--ink);
    font-size: var(--text-base);
  }
  .card-link:hover .card-row-title {
    color: var(--info);
  }
  .card-row-detail {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-3);
    align-items: center;
  }
  .card-row-metric {
    font-size: var(--text-xs);
    color: var(--ink-3);
  }

  .honesty p {
    max-width: var(--measure-wide);
    color: var(--ink-2);
    line-height: 1.7;
    margin: 0;
  }
</style>
