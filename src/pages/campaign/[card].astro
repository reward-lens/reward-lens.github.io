---
import Campaign from "@layouts/Campaign.astro";
import EvidenceChip from "@components/EvidenceChip.astro";
import VerdictChip from "@components/VerdictChip.astro";
import KillBadge from "@components/KillBadge.astro";
import ThemedFigure from "@components/ThemedFigure.astro";
import Callout from "@components/Callout.astro";
import PrevNext from "@components/PrevNext.astro";
import cards from "@data/cards.json";
import fleetIndex from "@data/fleet/index.json";

const fleetSlugs = new Set(fleetIndex.map((m) => m.slug));

export function getStaticPaths() {
  return cards.map((card) => ({
    params: { card: card.id },
    props: { card },
  }));
}

const { card } = Astro.props;
const index = cards.findIndex((c) => c.id === card.id);
const prevCard = index > 0 ? cards[index - 1] : undefined;
const nextCard = index < cards.length - 1 ? cards[index + 1] : undefined;

const day = (iso: string) => iso.slice(0, 10);
const fmt = (n: number | null | undefined): string => {
  if (n === null || n === undefined) return "not measured";
  if (Number.isInteger(n)) return String(n);
  const a = Math.abs(n);
  if (a !== 0 && (a < 1e-3 || a >= 1e4)) return n.toExponential(3);
  return String(Number(n.toPrecision(4)));
};

const firedCriterion = card.kill_fired
  ? card.kill_criteria.find((k: any) => k.id === card.kill_fired)
  : null;
const killObserved =
  firedCriterion &&
  (card.hypotheses.find((h: any) => h.metric === firedCriterion.metric)
    ?.observed ??
    (card.companion_metrics as Record<string, number>)[firedCriterion.metric]);

const lowPowerConfirmed =
  card.power_acceptance &&
  card.hypotheses.some(
    (h: any) =>
      h.outcome === "confirmed" &&
      h.observed !== null &&
      h.observed < card.power_acceptance.mde,
  );

const description = `${card.card}: ${card.hypotheses[0].statement}. Verdict: ${card.verdict}.`;
---

<Campaign
  title={`${card.card} · campaign · reward-lens`}
  description={description}
  ogImage={`/og/campaign-${card.id}.png`}
>
  <Fragment slot="breadcrumb">
    <a href="/campaign/">Campaign</a>
    <span>{card.card}</span>
  </Fragment>

  <header class="card-head">
    <p class="card-eyebrow">
      <span class="card-id">{card.card}</span>
      <a class="card-science" href="/science/"
        >{card.science} · {card.science_name}</a
      >
    </p>
    <h1>{card.title}</h1>
    <p class="card-verdict-row">
      <VerdictChip verdict={card.verdict as "confirmed" | "refuted" | "mixed" | "inconclusive"} />
      {card.kill_fired && <KillBadge kill={card.kill_fired} />}
    </p>
    <p class="card-provenance">
      frozen {day(card.frozen_at)} · adjudicated {day(card.adjudicated_at)} ·{" "}
      <code>{card.adjudication_ev}</code> ·{" "}
      <code>{card.spec_hash.slice(0, 18)}</code>
    </p>
  </header>

  <section class="card-predictions" aria-label="Frozen predictions and outcomes">
    <h2>The frozen predictions</h2>
    <ol class="pred-list">
      {
        card.hypotheses.map((h: any) => (
          <li class="pred-row">
            <div class="pred-statement">
              <span class="pred-id">{h.id}</span>
              {h.statement}
            </div>
            <div class="pred-detail">
              <code class="pred-metric">
                {h.metric} {h.comparator} {fmt(h.threshold)}
              </code>
              {h.registered_prob !== null && (
                <span class="pred-prob">
                  registered p {h.registered_prob}
                </span>
              )}
              {h.interval_prediction && (
                <span class="pred-prob">interval prediction</span>
              )}
              <span class="pred-observed">
                {h.observed !== null ? (
                  <EvidenceChip
                    value={h.observed}
                    trust="A"
                    evidenceId={card.adjudication_ev}
                    observable={h.metric}
                    subject={card.card}
                    threshold={`${h.comparator} ${fmt(h.threshold)}`}
                  />
                ) : (
                  <span class="pred-none">not measured</span>
                )}
              </span>
              <VerdictChip verdict={h.outcome} compact />
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  {
    card.kill_fired && firedCriterion && (
      <section class="card-kill" aria-label="Fired kill criterion">
        <p>
          <KillBadge kill={card.kill_fired} /> on{" "}
          <code>
            {firedCriterion.metric} {firedCriterion.comparator}{" "}
            {fmt(firedCriterion.threshold)}
          </code>
          {killObserved !== undefined && killObserved !== null && (
            <>
              , observed <code>{fmt(killObserved)}</code>
            </>
          )}
          : {card.kill_note}. A fired kill criterion is a registered negative
          result, not a failure of the machinery.
        </p>
      </section>
    )
  }

  {
    card.inconclusive_reason && (
      <Callout type="note" title="Why this card is inconclusive">
        <p>
          <code>{card.inconclusive_reason}</code>
        </p>
        <p>
          This is an engineering gap, not a finding: the arc that produces the
          missing intermediate can be re-run against the same frozen spec.
        </p>
      </Callout>
    )
  }

  {
    card.power_acceptance && (
      <Callout type="warn" title="Low-power acceptance, recorded at the freeze">
        <p>
          This card was frozen at power{" "}
          <code>{Number(card.power_acceptance.power.toPrecision(3))}</code> with
          MDE <code>{Number(card.power_acceptance.mde.toPrecision(3))}</code>.
          {lowPowerConfirmed &&
            " A confirmed headline sitting between the threshold and the MDE is a low-power-band detection, not a large-effect one."}
        </p>
        <p class="power-note">{card.power_acceptance.note}</p>
      </Callout>
    )
  }

  <ThemedFigure
    light={`/figures/campaign/${card.figure}.light.png`}
    dark={`/figures/campaign/${card.figure}.dark.png`}
    alt={`Adjudication figure for ${card.card}`}
    caption={card.caption}
    loading="eager"
  />

  {
    Object.keys(card.companion_metrics).length > 0 && (
      <section class="card-companions" aria-label="Registered companion metrics">
        <h2>Registered companions</h2>
        <ul class="companion-list">
          {Object.entries(card.companion_metrics).map(([metric, value]) => (
            <li>
              <code class="companion-name">{metric}</code>
              <EvidenceChip
                value={value as number}
                trust="A"
                evidenceId={card.adjudication_ev}
                observable={metric}
                subject={card.card}
              />
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="card-meta" aria-label="Subjects and artifacts">
    <h2>Subjects and artifacts</h2>
    <ul class="meta-list">
      {
        card.subjects.signals?.length > 0 && (
          <li>
            signals:{" "}
            {card.subjects.signals.map((s: string, i: number) => (
              <>
                {i > 0 && ", "}
                {fleetSlugs.has(s) ? (
                  <a href={`/atlas/${s}/`}>
                    <code>{s}</code>
                  </a>
                ) : (
                  <code>{s}</code>
                )}
              </>
            ))}
          </li>
        )
      }
      {
        card.subjects.datasets?.length > 0 && (
          <li>
            datasets:{" "}
            {card.subjects.datasets.map((d: string, i: number) => (
              <>
                {i > 0 && ", "}
                <code>{d}</code>
              </>
            ))}
          </li>
        )
      }
      <li>
        frozen spec: <a href={`/specs/${card.spec_file}`}><code>{card.spec_file}</code></a>
      </li>
      <li>
        figure files:{" "}
        <a href={`/figures/campaign/${card.figure}.light.png`}>light</a> ·{" "}
        <a href={`/figures/campaign/${card.figure}.dark.png`}>dark</a>
      </li>
      <li>
        study id: <code>{card.study_id}</code>
      </li>
    </ul>
  </section>

  <PrevNext
    prev={prevCard && { title: prevCard.card, href: `/campaign/${prevCard.id}/` }}
    next={nextCard && { title: nextCard.card, href: `/campaign/${nextCard.id}/` }}
  />
</Campaign>

<style>
  .card-head {
    padding: var(--sp-8) 0 var(--sp-6);
    border-bottom: 1px solid var(--line);
    margin-bottom: var(--sp-8);
  }
  .card-eyebrow {
    display: flex;
    gap: var(--sp-4);
    align-items: baseline;
    margin: 0 0 var(--sp-2);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
  .card-id {
    color: var(--ink-3);
    letter-spacing: 0.04em;
  }
  .card-science {
    color: var(--info);
    text-decoration: none;
    font-size: var(--text-xs);
  }
  .card-science:hover {
    text-decoration: underline;
  }
  .card-head h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    line-height: 1.15;
    margin: 0 0 var(--sp-4);
    max-width: 24ch;
  }
  .card-verdict-row {
    display: flex;
    gap: var(--sp-3);
    align-items: center;
    margin: 0 0 var(--sp-3);
  }
  .card-provenance {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-3);
  }
  .card-provenance code {
    color: var(--ink-2);
  }

  section h2 {
    font-size: var(--text-lg);
    font-weight: 600;
    margin: var(--sp-8) 0 var(--sp-4);
  }

  .pred-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .pred-row {
    border-bottom: 1px solid var(--line);
    padding: var(--sp-4) 0;
  }
  .pred-row:first-child {
    border-top: 1px solid var(--line);
  }
  .pred-statement {
    margin-bottom: var(--sp-2);
    color: var(--ink);
    max-width: var(--measure-wide);
  }
  .pred-id {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-3);
    margin-right: var(--sp-2);
  }
  .pred-detail {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    align-items: center;
    font-size: var(--text-sm);
  }
  .pred-metric {
    color: var(--ink-2);
  }
  .pred-prob {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-3);
  }
  .pred-observed {
    margin-left: auto;
  }
  .pred-none {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--ink-3);
  }

  .card-kill {
    border: 1px solid var(--bad);
    border-radius: var(--r-card);
    background: color-mix(in oklab, var(--bad) 6%, var(--bg-raised));
    padding: var(--sp-4);
    margin: var(--sp-6) 0;
    max-width: var(--measure-wide);
  }
  .card-kill p {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--ink);
    line-height: 1.6;
  }

  .power-note {
    color: var(--ink-3);
    font-size: var(--text-xs);
  }

  .companion-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3) var(--sp-6);
  }
  .companion-list li {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    align-items: center;
    font-size: var(--text-sm);
    min-width: 0;
  }
  .companion-name {
    color: var(--ink-2);
    overflow-wrap: anywhere;
  }

  .meta-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    font-size: var(--text-sm);
    color: var(--ink-2);
  }

  @media (max-width: 600px) {
    .pred-observed {
      margin-left: 0;
    }
  }
</style>
