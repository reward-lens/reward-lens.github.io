---
/**
 * `/`  ·  the room, then three movements.
 *
 * This page composes and does nothing else. Every section is a component under
 * `components/home/`, each of which owns its own data, its own copy keys and
 * its own guards. Nothing is read, filled or asserted here.
 *
 * THAT IS A CHANGE, and the reason is worth keeping. This file used to be the
 * page: nine sections built inline, thirty-three declarations of frontmatter
 * resolving evidence records, filling copy and warning about content it could
 * not bind. When the homepage was rebuilt into the three movements below, the
 * sections went to components and the frontmatter stayed, so the file kept
 * resolving records for a trust badge nobody rendered, filling three paragraphs
 * nobody printed, and warning at every build about missing content for
 * sections §4, §6 and §8, which by then did not exist. Twenty-nine of the
 * thirty-three declarations were dead, and so were twenty-two of the
 * twenty-three style rules. A page that computes what it does not show is a
 * page that will eventually show something it did not compute.
 *
 * The one warning worth keeping moved to its owner: the hosted-notebook link
 * has a label in copy.yaml and no URL, and `handoff-block.astro` says so in the
 * component that would render it.
 *
 * The movements, in scroll order:
 *
 *   ONE   `InstrumentStory`  the whole chain in five states, carried by the
 *                            instrument. A complete argument in DOM order with
 *                            no scene, which is what the reduced-motion,
 *                            no-WebGL and no-JavaScript paths get.
 *   TWO   `ProofBench`       three real mechanisms, each ending at the route
 *                            that shows the whole thing.
 *   THREE `TrustStrip`,      why a reading can be believed, what has not been
 *         `BoundaryMap`,     earned, and the reader's own run.
 *         `HandoffBlock`
 */
import Base from "@layouts/Base.astro";
import Hero from "@components/home/hero.astro";
import InstrumentStory from "@components/home/story/instrument-story.astro";
import ProofBench from "@components/home/proof/proof-bench.astro";
import TrustStrip from "@components/home/boundary/trust-strip.astro";
import BoundaryMap from "@components/home/boundary/boundary-map.astro";
import HandoffBlock from "@components/home/handoff/handoff-block.astro";
import { copy } from "../copy";

const home = copy.home as Record<string, any>;
---

<Base title={copy.meta.site_name} description={home.meta_description}>
  <!-- §1 · the claim. The room. -->
  <Hero />

  <div class="home">
    {/*
      MOVEMENT ONE: the whole chain, carried by the instrument.

      Five states in scroll order: what scored the rollout, what the optimizer
      actually saw, where the update came from, what the policy became, and what
      can be seen while the run is still changeable. The visual slot is empty
      until the live scene lands; the story is a complete argument in DOM order
      without it, which is the property that has to hold for the reduced-motion,
      no-WebGL and no-JavaScript paths anyway.
    */}
    <InstrumentStory />

    {/*
      MOVEMENT TWO: three real mechanisms, each with room to teach one idea.
      Not a feature grid. Each ends at the route that shows the whole thing.
    */}
    <ProofBench />

    {/*
      MOVEMENT THREE: why a reading can be believed, what has not been earned,
      and the reader's own run.

      The trust strip is deliberately here and deliberately short. It used to be
      the page's emotional centre, four abstract rungs above the fold, and that
      ordering asked a stranger to care how carefully the tool measures before
      telling them what it measures.
    */}
    <TrustStrip />
    <BoundaryMap />
    <HandoffBlock />
  </div>
</Base>

<style>
  .home {
    width: 100%;
    max-width: min(var(--grid-max), 100%);
    margin-inline: auto;
    padding-inline: var(--page-pad);
    padding-block: var(--space-9) var(--space-9);
    display: grid;
    gap: var(--space-9);
    min-width: 0;
  }

  /* CONTAINMENT, NOT A FIX, and the underlying defect is reported.
     provenance-chip.astro leaves a closed panel `position: absolute` at the
     chip's own left edge, capped at min(--measure-command, 100vw - --space-7).
     That cap does not account for how far into the line the number sits, so a
     chip past the halfway mark puts an invisible 544px box outside the viewport
     and the document's scrollWidth goes with it: 1148 at 768 and 1298 at 1024,
     measured. It reproduces on /gallery/ too (871 at 768), so it predates this
     page.

     Opening the panel switches it to `position: fixed` with measured
     coordinates, so on the scripted path a closed panel's absolute position is
     never used for anything. Parking it out of flow while closed changes
     nothing a reader sees and takes the overflow with it. The no-JavaScript
     path, where hover and focus open the absolute panel and its closed position
     IS its open position, is deliberately untouched. */
  :global(:root[data-js]) .home :global(.prov:not([data-open]) > .prov__panel) {
    position: fixed;
    inset-inline: 0 auto;
    top: 0;
  }
</style>
