---
import Base from "@layouts/Base.astro";
import PageHeader from "@components/PageHeader.astro";
import EvidenceChip from "@components/EvidenceChip.astro";
import VerdictChip from "@components/VerdictChip.astro";
import DataTable from "@components/DataTable.astro";
import theorems from "@data/theorems.json";
import cards from "@data/cards.json";

const ev = (id: string) => cards.find((c) => c.id === id)!.adjudication_ev;

const sciences = [
  ["S1", "Ground truth and calibration", "When attribution and patching disagree, which is right? Can a blind team handed reward-lens find a planted bias?"],
  ["S2", "Gauge and the scalar bottleneck", "Is a near-zero cosine between two reward directions a functional change or a coordinate change? Is learned preference empirically rank-1?"],
  ["S3", "Reward thermodynamics", "Are the feature-level consequences of optimizing against a grader derivable from base-policy statistics before any RL?"],
  ["S4", "Reward field theory", "Are the flat directions of the reward Hessian the hackable subspace? Is the exploit surface finite, or a hydra?"],
  ["S5", "Capacity theory of bias", "Does a scalar grader aggregating K criteria through a d-dimensional bottleneck suffer an irreducible interference floor?"],
  ["S6", "Preference topology", "Is a computable fraction of reward error topologically obligatory, forced by intransitivity in the preference data?"],
  ["S7", "Reward embryology and pretraining origins", "Does the reward direction form gradually or in phase transitions? Do surface biases enter before quality features?"],
  ["S8", "The knowledge-reward gap", "Does the RM represent a property its reward ignores, the mechanistic precondition of hacking?"],
  ["S9", "Do verifiers verify", "What fraction of an RM's correctness preference is causally anchored at the actual error versus carried by style?"],
  ["S10", "Decompiling and the legibility frontier", "How much of the learned decision function can be said in language, and what is the tacit remainder?"],
  ["S11", "Values, pluralism and paradigm physiology", "Do RMs encode contested pairs orthogonally to the reward direction? Is a judge's verdict decided before its critique is written?"],
  ["S12", "Hackability forecasting and certified prevention", "Can the KL location of the Goodhart hump and the first-hacked dimension be predicted from internals before any RL?"],
  ["S13", "The recorder, coupling, robustness, kinship and weak-to-strong", "Is hacking onset visible in reward-feature space before reward and KL curves move? When a weak grader teaches a strong model, which does the strong model learn: the values or the errors?"],
  ["S14", "Thermodynamic phase structure", "What is the order of the reward-hacking transition? Does it exhibit hysteresis? Does it sharpen with scale?"],
  ["S15", "Trajectory forensics and the economics of grading", "When a trajectory RM assigns reward, is it reading the receipts or the narrative?"],
  ["S16", "Certified robustness, attack surface and eval-awareness", "After erasing an attack's mediating subspace, what token budget re-breaks the RM? Does the RM internally recognize a benchmark item?"],
];

const problems = [
  { name: "Forecast the hack before any RL", science: "S12", card: "chi-drift", status: "first data point", q: "Can the KL location of the Goodhart hump and the first-hacked dimension be predicted from internals before any RL? The drift ordering held on a real bank; the hump-location arm never ran." },
  { name: "Calibration that transfers across scales", science: "S1", card: "cal-transfer", status: "refuting data point", q: "Instrument scorecards moved from a CPU toy trunk to a real 0.6B trunk with a max per-instrument AUC gap of 0.419 against a frozen 0.15 bound. The gap is now the problem statement." },
  { name: "Localize process errors in verifiers", science: "S9", card: "verif-prm", status: "instrument open", q: "Is the error represented at step k but priced at step k+2? The dense extractor failed its answer-key validation on a real PRM, so the instrument itself is open." },
  { name: "Which part of a reward direction is physical", science: "S2", card: "gauge-e19", status: "open", q: "Two RMs can be behaviorally identical with orthogonal reward directions. Both gauge cards await a clean run." },
  { name: "Is learned preference rank-one", science: "S2/S6", card: "topo-hodge", status: "first data point", q: "The preference data carries 21 percent cyclic mass no scalar head can express. What does the head do with it?" },
  { name: "Hysteresis and phase structure of hacking", science: "S14", card: null, status: "open", q: "Is the reward-hacking transition reversible? Does it sharpen with scale, like a genuine phase transition, or not?" },
  { name: "Does legibility grow or shrink with scale", science: "S10", card: "t3-decomp", status: "first data point", q: "Tacit fraction 0.97 at 8B is one point on the curve. Nobody knows even the sign of its slope." },
  { name: "Does the grader read the receipts", science: "S15", card: "forensic-receipt", status: "refuted on contact", q: "The first receipt instruments were refuted on contact with real graders and are being rebuilt." },
  { name: "The weak-to-strong elicitation boundary", science: "S13", card: null, status: "open", q: "Above what salience does a weak grader elicit the strong model's own values rather than install its errors?" },
  { name: "Capacity floors", science: "S5", card: "capacity-welch", status: "first data point", q: "Is some bias information-theoretically forced once the rubric outgrows the reward-relevant subspace? The Welch floor held once." },
  { name: "Kinship", science: "S13", card: null, status: "open", q: "Does a policy hack its sibling grader faster than a foreign one at matched accuracy?" },
  { name: "What mediates eval-awareness", science: "S16", card: "eval-aware", status: "first data point", q: "A probe reads benchmark-versus-organic at 0.79 balanced accuracy; steering the same direction moved reward by nothing. What carries the signal?" },
];
---

<Base
  title="Science · reward-lens"
  description="What one campaign settled, and what it opened."
>
  <div class="sci-wrap">
    <PageHeader
      display
      eyebrow="the science"
      title="What one campaign settled, and what it opened"
    />

    <section class="sci-block" aria-labelledby="settled-h">
      <h2 id="settled-h">Settled by one campaign</h2>
      <p>
        The fluctuation-dissipation prediction for reward hacking has its
        first real-model confirmation: susceptibility measured on a base
        policy predicted realized best-of-n feature drift at rho
        <EvidenceChip
          value={0.964286}
          trust="A"
          evidenceId={ev("chi-drift")}
          observable="chi_bon_spearman"
          subject="CHI-DRIFT"
          threshold="> 0.3"
        /> on one model and 1.0 on a second (standing theorem T9, via
        <a href="/campaign/chi-drift/">CHI-DRIFT</a>). Value-convergence
        excess has its first real refutation at fleet size ten:
        <EvidenceChip
          value={-0.0698739}
          trust="A"
          evidenceId={ev("atlas-vce")}
          observable="real_vce"
          subject="ATLAS-VCE"
          threshold="> 0"
        /> against the capability-matched null, so the apparent convergence
        of machine values was fully explained by shared capability structure
        (T13, refuted via <a href="/campaign/atlas-vce/">ATLAS-VCE</a>).
      </p>
      <p>
        A real generative judge commits to its verdict before writing its
        critique: the verdict decoded at the pre-critique position matched the
        final verdict at rate
        <EvidenceChip
          value={1.0}
          trust="A"
          evidenceId={ev("judge-vbc")}
          observable="verdict_prefix_match_rate"
          subject="JUDGE-VBC"
          threshold=">= 0.9"
        /> (<a href="/campaign/judge-vbc/">JUDGE-VBC</a>). A fifth of the
        preference data's structure is cyclic mass no scalar head can
        represent:
        <EvidenceChip
          value={0.213976}
          trust="A"
          evidenceId={ev("topo-hodge")}
          observable="intransitive_mass"
          subject="TOPO-HODGE"
          threshold="> 0.03"
        /> (<a href="/campaign/topo-hodge/">TOPO-HODGE</a>). And the
        meta-result: the campaign scored its own pre-run confidence and
        published the miss, a Brier of
        <EvidenceChip
          value={0.26}
          trust="A"
          evidenceId={ev("meta-ledger")}
          observable="brier_directional"
          subject="META-LEDGER"
          threshold="< 0.25"
        /> against the coin's 0.25
        (<a href="/campaign/meta-ledger/">META-LEDGER</a>, K-meta fired).
      </p>
    </section>

    <section class="sci-block" aria-labelledby="board-h">
      <h2 id="board-h">The standing board</h2>
      <DataTable compact>
        <table>
          <thead>
            <tr>
              <th>Row</th>
              <th>Title</th>
              <th>Kind</th>
              <th>Status</th>
              <th>Science</th>
              <th>Adjudicated by</th>
            </tr>
          </thead>
          <tbody>
            {
              theorems.map((t) => (
                <tr>
                  <td>
                    <code>{t.id}</code>
                  </td>
                  <td>{t.title}</td>
                  <td class="t-kind">
                    {t.kind === "standing_theorem" ? "standing" : "candidate law"}
                  </td>
                  <td>
                    {t.status === "open" ? (
                      <span class="t-open">○ open</span>
                    ) : (
                      <VerdictChip verdict={t.status as any} compact />
                    )}
                  </td>
                  <td>
                    <code>{t.science}</code>
                  </td>
                  <td>
                    {t.card && (
                      <a href={`/campaign/${t.card}/`}>
                        {t.card.toUpperCase()}
                      </a>
                    )}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </DataTable>
    </section>

    <section class="sci-block" aria-labelledby="problems-h">
      <h2 id="problems-h">The open problems</h2>
      <ol class="problem-list">
        {
          problems.map((p) => (
            <li class="problem">
              <div class="problem-head">
                <h3>{p.name}</h3>
                <span class="problem-tags">
                  <code>{p.science}</code>
                  <span class="problem-status">{p.status}</span>
                  {p.card && (
                    <a href={`/campaign/${p.card}/`}>
                      {p.card.toUpperCase()}
                    </a>
                  )}
                </span>
              </div>
              <p>{p.q}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="sci-block" aria-labelledby="sciences-h">
      <h2 id="sciences-h">The sixteen sciences</h2>
      <p class="sci-thesis">One kernel, sixteen sciences, three gates.</p>
      <dl class="science-index">
        {
          sciences.map(([id, name, q]) => (
            <div class="science-row">
              <dt>
                <code>{id}</code> {name}
              </dt>
              <dd>{q}</dd>
            </div>
          ))
        }
      </dl>
      <p class="sci-meta">
        Two cross-cutting meta-studies: universality of machine values (the
        VCE question, first refutation on the fleet) and performative
        interpretability (the audit half-life of each metric under developer
        response).
      </p>
    </section>

    <p class="sci-invite">
      Collaboration runs through
      <a href="https://github.com/reward-lens/reward-lens/issues"
        >GitHub issues</a
      >.
    </p>
  </div>
</Base>

<style>
  .sci-wrap {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 0 var(--page-pad) var(--sp-12);
  }
  .sci-block {
    margin-bottom: var(--sp-16);
  }
  .sci-block h2 {
    font-size: var(--text-2xl);
    font-weight: 600;
    margin: 0 0 var(--sp-4);
  }
  .sci-block > p {
    max-width: var(--measure-wide);
    color: var(--ink-2);
    line-height: 1.8;
  }
  .t-kind,
  .t-open {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-3);
    white-space: nowrap;
  }

  .problem-list {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: prob;
  }
  .problem {
    border-bottom: 1px solid var(--line);
    padding: var(--sp-4) 0;
  }
  .problem:first-child {
    border-top: 1px solid var(--line);
  }
  .problem-head {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-4);
    align-items: baseline;
    justify-content: space-between;
  }
  .problem h3 {
    margin: 0;
    font-size: var(--text-base);
    font-weight: 600;
  }
  .problem-tags {
    display: inline-flex;
    gap: var(--sp-3);
    align-items: baseline;
    font-size: var(--text-xs);
  }
  .problem-tags code {
    color: var(--ink-3);
  }
  .problem-status {
    font-family: var(--font-mono);
    color: var(--ink-3);
  }
  .problem p {
    margin: var(--sp-2) 0 0;
    font-size: var(--text-sm);
    color: var(--ink-2);
    line-height: 1.7;
    max-width: var(--measure-wide);
  }

  .sci-thesis {
    font-family: var(--font-mono);
    color: var(--ink-3);
    font-size: var(--text-sm);
    margin: 0 0 var(--sp-4);
  }
  .science-index {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--sp-4);
  }
  .science-row {
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    padding: var(--sp-3) var(--sp-4);
  }
  .science-row dt {
    font-weight: 600;
    margin-bottom: var(--sp-1);
  }
  .science-row dt code {
    color: var(--ink-3);
    font-size: var(--text-xs);
    margin-right: var(--sp-1);
  }
  .science-row dd {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--ink-2);
    line-height: 1.6;
  }
  .sci-meta {
    margin-top: var(--sp-6);
    font-size: var(--text-sm);
    color: var(--ink-3);
    max-width: var(--measure-wide);
  }
  .sci-invite {
    color: var(--ink-2);
  }
</style>
