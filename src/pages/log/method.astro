---
import { readFileSync } from "node:fs";
import Campaign from "@layouts/Campaign.astro";
import PageHeader from "@components/PageHeader.astro";
import DataTable from "@components/DataTable.astro";
import cards from "@data/cards.json";
import summary from "@data/campaign.json";
import worksLedger from "@data/works-ledger.json";
import chiSpec from "@data/specs/campaign-chi-drift.json";
import manifest from "@data/specs/manifest.json";

const adjLine = readFileSync(
  new URL("src/data/claims-store/evidence.jsonl", `file://${process.cwd()}/`),
  "utf-8",
)
  .split("\n")
  .find((l) => l.includes("campaign.adjudication.CHI-DRIFT"));
const adjRecord = JSON.parse(adjLine!);

const powered = cards.filter((c) => c.power_acceptance);
const inconclusive = cards.filter((c) => c.verdict === "inconclusive");
const specWithoutFile = { ...chiSpec } as Record<string, unknown>;

const gpuHours = (summary.gpu_seconds / 3600).toFixed(1);
const arcs = summary.gpu_seconds_by_arc.slice(0, 2);
const fmtP = (n: number) => Number(n.toPrecision(3));
---

<Campaign
  title="How the machinery keeps us honest · reward-lens"
  description="The trust ladder, the freeze, mechanical adjudication, the honest engineering accounting, and the failure classes this machinery exists to prevent."
>
  <Fragment slot="breadcrumb">
    <a href="/log/">The archive</a>
    <span>Method</span>
  </Fragment>

  <PageHeader
    display
    eyebrow="the method"
    title="How the machinery keeps us honest"
    lede="What a number on this site had to survive before it was allowed to appear."
  />

  <div class="method">
    <section aria-labelledby="m-ladder">
      <h2 id="m-ladder">1 · The trust ladder and the three gates</h2>
      <p>
        Every measurement in reward-lens returns an Evidence object, and every
        Evidence object carries a trust level: exploratory, calibrated,
        registered, or adjudicated. The rungs are earned. A bare measurement is
        exploratory. It becomes calibrated when the instrument that produced it
        holds a scorecard from runs against
        <a href="/docs/discipline/calibration-and-organisms/"
          >planted ground truth</a
        >. It becomes registered when the prediction it tests was frozen before
        the evidence existed. It becomes adjudicated when machinery compared it
        to its frozen threshold and wrote the verdict into the store.
      </p>
      <p>
        Three gates enforce this. The first computes the trust level from the
        calibration and registration facts. The second refuses to compare
        coordinate-dependent quantities across models unless a shared
        <a href="/docs/discipline/gauge-and-frames/">frame</a> is supplied. The
        third is the
        <a href="/docs/discipline/studies-and-preregistration/">study runner</a
        >: freeze, run, adjudicate, in that order, with the spec hashes checked
        at adjudication time.
      </p>
      <p class="method-close">
        Trust levels are computed by the gates and cannot be set by callers.
      </p>
    </section>

    <section aria-labelledby="m-freeze">
      <h2 id="m-freeze">2 · The freeze</h2>
      <p>
        The freeze manifest records the timestamp, the git sha, the tag, and
        one hash per spec. The <code>+dirty</code> suffix that appears on the
        sha in the frozen specs is disclosed in the sha string itself rather
        than cleaned away.
      </p>
      <pre class="method-json" tabindex="0" role="group" aria-labelledby="m-freeze"><code>{JSON.stringify({
        created_at: manifest.created_at,
        git_sha: manifest.git_sha,
        tag: manifest.tag,
        code_tree_hash: manifest.code_tree_hash,
        spec_hashes: [...manifest.spec_hashes.slice(0, 4), "… 23 more"],
      }, null, 1)}</code></pre>
      <details class="method-details">
        <summary id="m-spec-sum">One frozen spec, shown whole: campaign-chi-drift.json</summary>
        <pre class="method-json" tabindex="0" role="group" aria-labelledby="m-spec-sum"><code>{JSON.stringify(specWithoutFile, null, 1)}</code></pre>
      </details>
    </section>

    <section aria-labelledby="m-adjudication">
      <h2 id="m-adjudication">3 · Adjudication</h2>
      <p>
        An adjudication record holds the frozen thresholds and comparators,
        the observed metrics, and one outcome per hypothesis. A kill criterion
        is a pre-registered condition under which the card's claim is declared
        dead; when one fires, the record says so, and the result stands as a
        registered negative, not a discarded run.
      </p>
      <p>
        <a href={`/evidence/${adjRecord.id.replace("ev:", "")}/`}>
          One adjudication record, shown whole: {adjRecord.id}
        </a>
      </p>
    </section>

    <section aria-labelledby="m-engineering">
      <h2 id="m-engineering">4 · The honest engineering section</h2>

      <h3>Eight inconclusive cards, with their verbatim reasons</h3>
      <ul class="reason-list">
        {
          inconclusive.map((c) => (
            <li>
              <a href={`/log/cards/${c.id}/`}>{c.title}</a>:{" "}
              <code>{c.inconclusive_reason}</code>
            </li>
          ))
        }
      </ul>
      <p>
        Two hit a permission error in subject resolution; six were missing an
        intermediate because an arc never ran or its shard never merged. These
        are engineering gaps, not findings, and the frozen specs they would be
        adjudicated against are unchanged.
      </p>

      <h3>Eight low-power acceptances, recorded at the freeze</h3>
      <DataTable compact>
        <table>
          <thead>
            <tr>
              <th>Card</th>
              <th>Power</th>
              <th>MDE</th>
            </tr>
          </thead>
          <tbody>
            {
              powered.map((c) => (
                <tr>
                  <td>
                    <a href={`/log/cards/${c.id}/`}>{c.title}</a>
                  </td>
                  <td>
                    <code>{fmtP(c.power_acceptance!.power)}</code>
                  </td>
                  <td>
                    <code>{fmtP(c.power_acceptance!.mde)}</code>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </DataTable>
      <p>
        A confirmed headline sitting between its threshold and its recorded
        MDE is a low-power-band detection, and each affected card page says
        so. A 28th designed card, T3-27B, was never frozen and appears in no
        ledger row.
      </p>

      <h3>Spend</h3>
      <p>
        Metered spend was ${summary.spend_usd.toFixed(2)} across{" "}
        {summary.gpu_seconds.toLocaleString("en-US")} H100-seconds (about{" "}
        {gpuHours} H100-hours), summed from the cost fields of the{" "}
        {summary.store_records} records in the merged store. The largest arcs:{" "}
        {arcs.map((a, i) => (
          <>
            {i > 0 && " and "}
            <code>{a.arc}</code> at {Math.round(a.gpu_seconds).toLocaleString("en-US")}{" "}
            GPU-seconds
          </>
        ))}. The merge report: {summary.merge_report.merged} records merged, 0
        skipped, 0 missing, 0 failed. The claims checker ran against the store
        at close: {summary.claims.checked} claims checked,{" "}
        {summary.claims.failures} failures.
      </p>

      <h3>The works ledger</h3>
      <p>
        Sixty-five feature rows account for every instrument, adapter, index,
        and loop the campaign touched: 45 PASS or PASS-DEGRADED, 4 FAIL, 7
        EXCUSED, 9 NOT-RUN. Every FAIL is a filed bug or a documented
        limitation, never a blank. Among the seats that ran without earning an
        Atlas card: the process RM <code>Qwen2.5-Math-PRM-7B</code>, where the
        dense extractor failed its answer-key validation and K-verif fired,
        and the generative judge <code>Skywork-Critic-Llama-3.1-8B</code>, the
        JUDGE-VBC subject.
      </p>
      <details class="method-details">
        <summary>All 65 feature rows</summary>
        <DataTable compact stickyFirst>
          <table>
            <thead>
              <tr>
                <th>Feature</th>
                <th>Subsystem</th>
                <th>Exercised by</th>
                <th>Status</th>
                <th>Evidence</th>
              </tr>
            </thead>
            <tbody>
              {
                worksLedger.features.map((r) => (
                  <tr>
                    <td>{r.feature}</td>
                    <td>{r.subsystem}</td>
                    <td>{r.exercised_by}</td>
                    <td>
                      <code>{r.status}</code>
                    </td>
                    <td>{r.evidence_id && <code>{r.evidence_id}</code>}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </DataTable>
      </details>
    </section>

    <section aria-labelledby="m-failure">
      <h2 id="m-failure">
        5 · Failure classes this machinery exists to prevent
      </h2>
      <p>
        The first version of this library produced confident, wrong numbers in
        seven documented ways. Each failure class now has a design feature
        that blocks it and a campaign card that demonstrates the block, with
        the evidence id of the demonstrating run.
      </p>
      <DataTable compact>
        <table>
          <thead>
            <tr>
              <th>v1 failure class</th>
              <th>What blocks it now</th>
              <th>Demonstrated by</th>
              <th>Evidence</th>
            </tr>
          </thead>
          <tbody>
            {
              worksLedger.failure_classes.map((r) => (
                <tr>
                  <td>{r.feature}</td>
                  <td>{r.substrate}</td>
                  <td>{r.exercised_by}</td>
                  <td>{r.evidence_id && <code>{r.evidence_id}</code>}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </DataTable>
    </section>

    <section aria-labelledby="m-repro">
      <h2 id="m-repro">6 · Reproduction</h2>
      <p>
        What ships today: the 27 frozen specs (<a href="/specs/manifest.json"
          >manifest</a
        >, viewable per card), the store projections this site is built from,
        the 62 adjudication figures, and this site's own
        <a href="https://github.com/reward-lens/reward-lens.github.io"
          >data pipeline</a
        > with its assertions. The campaign harness itself accompanies a
        future release of the library.
      </p>
    </section>
  </div>
</Campaign>

<style>
  .method {
    display: flex;
    flex-direction: column;
    gap: var(--sp-12);
    padding-bottom: var(--sp-8);
  }
  .method section > h2 {
    font-size: var(--text-xl);
    font-weight: 600;
    margin: 0 0 var(--sp-4);
  }
  .method section > h3 {
    font-size: var(--text-base);
    font-weight: 600;
    margin: var(--sp-6) 0 var(--sp-3);
  }
  .method p,
  .method ul {
    max-width: var(--measure-prose);
    color: var(--ink-2);
    line-height: 1.7;
  }
  .method-close {
    color: var(--ink);
    font-weight: 600;
  }
  .method-json {
    background: var(--bg-inset);
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    padding: var(--sp-3);
    font-size: var(--text-xs);
    line-height: 1.5;
    color: var(--ink-2);
    overflow-x: auto;
    max-height: 30rem;
    overflow-y: auto;
  }
  .method-details summary {
    cursor: pointer;
    font-size: var(--text-sm);
    color: var(--info);
    padding: var(--sp-2) 0;
  }
  .reason-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    font-size: var(--text-sm);
  }
  .reason-list code {
    font-size: var(--text-xs);
  }
</style>
