---
/**
 * Every page of the ported corpus. Eighty-four of them.
 *
 * The prose is the library's, unchanged: scripts/port_docs.py rewrites
 * delimiters, admonitions, figures and links and passes everything else
 * through byte-identical. This route adds the frame and nothing else, which is
 * the property that lets the corpus be repointed at a new library version
 * without a site change.
 */
import { getCollection, render } from "astro:content";
import Docs from "@layouts/Docs.astro";
import "@styles/docs-legacy.css";
import docsNav from "@data/docs-nav.json";
import type { NavItem } from "@components/docs/types";

export async function getStaticPaths() {
  const entries = await getCollection("docs");
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const current = `/docs/${entry.id}/`;

// The Pagefind section name, taken from the top-level nav group this page sits
// under. It is the library's own nav title, so the search overlay groups
// results by the same names the sidebar uses and nothing is written twice.
const nav = docsNav as NavItem[];
const sectionOf = (): string => {
  const inside = (item: NavItem): boolean =>
    item.href === current || (item.children ?? []).some(inside);
  return nav.find(inside)?.title ?? "";
};
---

<Docs
  title={entry.data.title}
  description={entry.data.description}
  current={current}
  libraryVersion={entry.data.libraryVersion}
  staleMarkers={entry.data.staleMarkers}
  headings={headings}
  section={sectionOf()}
>
  <div class="docs-prose">
    <Content />
  </div>
</Docs>
