---
// Build-time component review surface. Renders every shared component with real
// data from src/data. Deleted before launch; not linked from anywhere.
import Base from "@layouts/Base.astro";
import EvidenceChip from "@components/EvidenceChip.astro";
import VerdictChip from "@components/VerdictChip.astro";
import KillBadge from "@components/KillBadge.astro";
import TrustBadge from "@components/TrustBadge.astro";
import DataTable from "@components/DataTable.astro";
import MicroBar from "@components/MicroBar.astro";
import Callout from "@components/Callout.astro";
import CodeBlock from "@components/CodeBlock.astro";
import InstallStrip from "@components/InstallStrip.astro";
import TerminalExcerpt from "@components/TerminalExcerpt.astro";
import StatRow from "@components/StatRow.astro";
import SectionNav from "@components/SectionNav.astro";
import PrevNext from "@components/PrevNext.astro";
import LogEntry from "@components/LogEntry.astro";
import PageHeader from "@components/PageHeader.astro";
import ThemedFigure from "@components/ThemedFigure.astro";
import Prose from "@components/Prose.astro";

import ledger from "@data/ledger.json";
import campaign from "@data/campaign.json";
import docsNav from "@data/docs-nav.json";

const rows = (ledger as any[]).slice(0, 10);

const outcomeToVerdict: Record<string, "confirmed" | "refuted" | "inconclusive"> = {
  confirmed: "confirmed",
  refuted: "refuted",
  inconclusive: "inconclusive",
};

const usd = (n: number) =>
  "$" + n.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const int = (n: number) => Math.round(n).toLocaleString("en-US");

const stats = [
  { value: usd(campaign.spend_usd), label: "Total spend", trust: "A" as const },
  { value: int(campaign.gpu_seconds), label: "GPU seconds", trust: "A" as const },
  { value: String(campaign.hypotheses.total), label: "Hypotheses" },
  { value: String(campaign.cards.total), label: "Cards adjudicated" },
  { value: String(campaign.kills_fired.length), label: "Kills fired" },
  { value: int(campaign.store_records), label: "Evidence records" },
];

// Maximum absolute observed magnitude across the shown rows, for MicroBar scale.
const maxObs = Math.max(
  ...rows.map((r) => Math.abs(typeof r.observed === "number" ? r.observed : 0)),
  0.001,
);
---

<Base title="Component review" description="Build-time review of the reward-lens component vocabulary.">
  <div class="dev">
    <PageHeader
      eyebrow="Design system"
      title="Component review"
      lede="Every shared component rendered with real campaign data. This page is a build-time review surface and is removed before launch."
      display={true}
    />

    <section class="dev-section">
      <h2>EvidenceChip</h2>
      <p class="dev-note">
        The signature atom, inline in a sentence. The Bradley-Terry rank
        agreement for chi-drift came in at
        {" "}
        <EvidenceChip
          value={0.9642857142857145}
          trust="A"
          observable="chi_bon_spearman"
          subject="skywork-v2-qwen3-8b"
          ci={[0.7500000000000002, 1]}
          threshold="> 0.3"
          evidenceId="ev:c978e3958769ecf93dcf079771a3aedb"
        />
        {" "}
        against a registered floor, and still beat the variance baseline at
        {" "}
        <EvidenceChip
          value={0.5714285714285714}
          trust="A"
          observable="chi_minus_variance_baseline_spearman"
          subject="skywork-v2-qwen3-8b"
          ci={[0.07142857142857151, 0.5714285714285716]}
          threshold="> 0"
          evidenceId="ev:c978e3958769ecf93dcf079771a3aedb"
        />
        . Hover or focus either chip for provenance.
      </p>
      <p class="dev-note">
        In a table cell, with the popover reaching outside the row:
      </p>
      <DataTable>
        <table>
          <thead>
            <tr><th>Hypothesis</th><th>Metric</th><th class="num">Observed</th><th>Outcome</th></tr>
          </thead>
          <tbody>
            <tr>
              <td>H-chi-bon</td>
              <td>chi_bon_spearman</td>
              <td class="num">
                <EvidenceChip
                  value={0.9642857142857145}
                  trust="A"
                  observable="chi_bon_spearman"
                  subject="skywork-v2-qwen3-8b"
                  ci={[0.7500000000000002, 1]}
                  threshold="> 0.3"
                  evidenceId="ev:c978e3958769ecf93dcf079771a3aedb"
                />
              </td>
              <td><VerdictChip verdict="confirmed" compact /></td>
            </tr>
            <tr>
              <td>H-chi-beats-var</td>
              <td>chi_minus_variance_baseline_spearman</td>
              <td class="num">
                <EvidenceChip
                  value={0.5714285714285714}
                  trust="A"
                  observable="chi_minus_variance_baseline_spearman"
                  subject="skywork-v2-qwen3-8b"
                  ci={[0.07142857142857151, 0.5714285714285716]}
                  threshold="> 0"
                  evidenceId="ev:c978e3958769ecf93dcf079771a3aedb"
                />
              </td>
              <td><VerdictChip verdict="confirmed" compact /></td>
            </tr>
          </tbody>
        </table>
      </DataTable>
    </section>

    <section class="dev-section">
      <h2>VerdictChip</h2>
      <div class="dev-inline">
        <VerdictChip verdict="confirmed" />
        <VerdictChip verdict="refuted" />
        <VerdictChip verdict="mixed" />
        <VerdictChip verdict="inconclusive" />
      </div>
      <p class="dev-note">Compact variant:</p>
      <div class="dev-inline">
        <VerdictChip verdict="confirmed" compact />
        <VerdictChip verdict="refuted" compact />
        <VerdictChip verdict="mixed" compact />
        <VerdictChip verdict="inconclusive" compact />
      </div>
    </section>

    <section class="dev-section">
      <h2>KillBadge</h2>
      <div class="dev-inline">
        {campaign.kills_fired.map((k) => <KillBadge kill={k} />)}
      </div>
    </section>

    <section class="dev-section">
      <h2>TrustBadge</h2>
      <div class="dev-inline">
        <TrustBadge trust="E" />
        <TrustBadge trust="C" />
        <TrustBadge trust="R" />
        <TrustBadge trust="A" />
      </div>
      <p class="dev-note">With full word:</p>
      <div class="dev-inline">
        <TrustBadge trust="EXPLORATORY" word />
        <TrustBadge trust="CALIBRATED" word />
        <TrustBadge trust="REGISTERED" word />
        <TrustBadge trust="ADJUDICATED" word />
      </div>
    </section>

    <section class="dev-section">
      <h2>StatRow</h2>
      <StatRow stats={stats} />
    </section>

    <section class="dev-section">
      <h2>DataTable</h2>
      <p class="dev-note">Ten ledger rows, sticky header, first column sticky on narrow scroll.</p>
      <DataTable stickyFirst>
        <table>
          <thead>
            <tr>
              <th>Card</th>
              <th>Hypothesis</th>
              <th>Metric</th>
              <th>Registered</th>
              <th class="num">Observed</th>
              <th>Magnitude</th>
              <th>Outcome</th>
              <th>Kill</th>
            </tr>
          </thead>
          <tbody>
            {
              rows.map((r) => (
                <tr>
                  <td>{r.card}</td>
                  <td>{r.hypothesis_id}</td>
                  <td>{r.metric}</td>
                  <td class="num">{r.comparator} {r.threshold}</td>
                  <td class="num">
                    {typeof r.observed === "number"
                      ? Number(r.observed.toPrecision(4))
                      : "—"}
                  </td>
                  <td>
                    <MicroBar
                      value={Math.abs(typeof r.observed === "number" ? r.observed : 0)}
                      max={maxObs}
                      color={
                        r.outcome === "confirmed"
                          ? "ok"
                          : r.outcome === "refuted"
                            ? "bad"
                            : "none"
                      }
                    />
                  </td>
                  <td><VerdictChip verdict={outcomeToVerdict[r.outcome]} compact /></td>
                  <td>{r.kill_id ? <KillBadge kill={r.kill_id} /> : ""}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </DataTable>
    </section>

    <section class="dev-section">
      <h2>MicroBar</h2>
      <div class="dev-inline">
        <span class="mb-demo"><MicroBar value={0.96} max={1} color="ok" /> 0.96</span>
        <span class="mb-demo"><MicroBar value={0.57} max={1} color="accent" /> 0.57</span>
        <span class="mb-demo"><MicroBar value={0.23} max={1} color="mix" /> 0.23</span>
        <span class="mb-demo"><MicroBar value={0.08} max={1} color="none" /> 0.08</span>
      </div>
    </section>

    <section class="dev-section">
      <h2>Callout</h2>
      <Callout type="note">A quiet note in the info family. Never a status color.</Callout>
      <Callout type="info" title="Info">Informational context with a title.</Callout>
      <Callout type="tip">A useful tip. Same restrained treatment.</Callout>
      <Callout type="warn" title="Warning">A caution that leans on the accent edge.</Callout>
      <Callout type="important" title="Important">Something worth reading carefully.</Callout>
    </section>

    <section class="dev-section">
      <h2>InstallStrip</h2>
      <InstallStrip />
    </section>

    <section class="dev-section">
      <h2>CodeBlock</h2>
      <CodeBlock filename="score.py" lang="python">from reward_lens import Lens

lens = Lens.load("skywork-v2-qwen3-8b")
report = lens.score("ultrafeedback-bank")
print(report.chi_bon_spearman)</CodeBlock>
    </section>

    <section class="dev-section">
      <h2>TerminalExcerpt</h2>
      <TerminalExcerpt title="reward-lens --version">reward-lens 2.0.1
python 3.11.9
torch 2.4.0</TerminalExcerpt>
    </section>

    <section class="dev-section">
      <h2>ThemedFigure</h2>
      <ThemedFigure
        light="/figures/campaign/card-chi-drift.light.png"
        dark="/figures/campaign/card-chi-drift.dark.png"
        alt="Chi-drift rank agreement against the registered floor."
        caption="CHI-DRIFT: chi tracks Bradley-Terry rank agreement across the drift sweep."
        loading="eager"
      />
    </section>

    <section class="dev-section">
      <h2>PageHeader</h2>
      <div class="dev-card">
        <PageHeader eyebrow="Campaign" title="Standard header" lede="Non-display variant in the UI face." />
      </div>
      <div class="dev-card">
        <PageHeader eyebrow="Campaign" title="Display header" lede="Display variant in Instrument Serif." display={true} />
      </div>
    </section>

    <section class="dev-section">
      <h2>SectionNav</h2>
      <div class="dev-nav-frame">
        <SectionNav items={docsNav as any[]} current="/docs/getting-started/install/" />
      </div>
    </section>

    <section class="dev-section">
      <h2>LogEntry</h2>
      <div class="dev-log">
        <LogEntry
          date={new Date("2026-07-22")}
          type="release"
          title="reward-lens 2.0.1 published to PyPI"
          links={[
            { label: "PyPI", href: "https://pypi.org/project/reward-lens/" },
            { label: "Notes", href: "https://github.com/reward-lens/reward-lens/releases" },
          ]}
        />
        <LogEntry
          date={new Date("2026-07-18")}
          type="results"
          title="Campaign frozen at 27 specs"
          links={[{ label: "Method", href: "/campaign/method/" }]}
        />
        <LogEntry date={new Date("2026-07-10")} type="release" title="reward-lens 2.0.0 shipped" />
      </div>
    </section>

    <section class="dev-section">
      <h2>PrevNext</h2>
      <PrevNext
        prev={{ title: "Reading a card", href: "/docs/reading-a-card/" }}
        next={{ title: "Kill criteria", href: "/docs/kill-criteria/" }}
      />
    </section>

    <section class="dev-section">
      <h2>Prose</h2>
      <Prose>
        <h3>Calm prose surface</h3>
        <p>
          Prose renders at the reading measure with generous line height. It is
          the counterpart to the dense data surfaces above. Inline
          <code>code</code> stays legible without shouting.
        </p>
      </Prose>
    </section>
  </div>
</Base>

<style>
  .dev {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: var(--sp-8) var(--page-pad) var(--sp-16);
  }
  .dev-section {
    margin: var(--sp-12) 0;
    padding-top: var(--sp-6);
    border-top: 1px solid var(--line);
  }
  .dev-section h2 {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-3);
    margin: 0 0 var(--sp-4);
  }
  .dev-note {
    color: var(--ink-2);
    font-size: var(--text-sm);
    max-width: var(--measure-prose);
    margin: var(--sp-4) 0;
  }
  .dev-inline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-3);
  }
  .mb-demo {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--ink-2);
  }
  .dev-card {
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    background: var(--bg-raised);
    padding: var(--sp-6);
    margin-bottom: var(--sp-4);
  }
  .dev-nav-frame {
    max-width: 280px;
    max-height: 460px;
    overflow-y: auto;
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    padding: var(--sp-4);
    background: var(--bg-raised);
  }
  .dev-log {
    max-width: var(--measure-wide);
  }
</style>
