  /* THESE SELECTORS ARE GLOBAL AND THAT IS NOT LAZINESS. Astro scopes a page's
     styles by stamping `data-astro-cid-<page>` on elements in the PAGE's own
     markup, and a child component's root element carries only its own id. Every
     spacing class this route hands to a component was therefore inert: the rule
     compiled to `.rm__facts[data-astro-cid-<page>]` and matched nothing,
     which is why prose and the table beneath it sat with no interval between
     them on every part of this route. Invisible in the code, obvious in the
     picture.

     The names are route-prefixed, so a global rule here cannot collide with
     anything: `rm__*` exists on this route and nowhere else. */
  :global(.rm__facts),
  :global(.rm__block-p) {
    margin-block-start: var(--space-5);
  }

  .rm__rule {
    margin-block-start: var(--space-6);
  }
</style>
