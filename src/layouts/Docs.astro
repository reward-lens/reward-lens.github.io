---
/**
 * The documentation frame, over Base.
 *
 * Three columns at --bp-xl, two at --bp-lg, one below it, and at every step
 * something specific becomes something else rather than disappearing:
 *
 *   >= --bp-xl   sidebar | prose | contents rail
 *   >= --bp-lg   sidebar | prose, and the rail becomes a wrapped row above it
 *   <  --bp-lg   prose, with the sidebar as a <details> picker above it and
 *                the rail still a row
 *
 * That is §12's rule for the whole documentation frame and it is the
 * difference between a layout and a set of display:none.
 *
 * Every documentation page carries three things this layout owns: the version
 * banner derived from the page's own libraryVersion, the copy-as-markdown
 * control pointing at that page's markdown twin, and the search trigger, which
 * loads nothing until it is opened.
 */
import Base from "./Base.astro";
import DocsSidebar from "@components/docs/docs-sidebar.astro";
import ContentsRail from "@components/docs/contents-rail.astro";
import SearchOverlay from "@components/docs/search-overlay.astro";
import CopyPage from "@components/docs/copy-page.astro";
import PrevNext from "@components/PrevNext.astro";
import VersionChip from "@components/base/version-chip.astro";
import type { NavItem, Heading, SymbolEntry } from "@components/docs/types";
import docsNav from "@data/docs-nav.json";
import { ui } from "../copy";

interface Props {
  title: string;
  description: string;
  /** The current route path, WITH its trailing slash. */
  current: string;
  /** The version of the library tree this page describes. */
  libraryVersion: string;
  /** Older releases this page's own prose still names. */
  staleMarkers?: string[];
  headings?: Heading[];
  symbols?: SymbolEntry[];
  railForm?: "headings" | "symbols";
  railLabel?: string;
  /** The Pagefind section name for this page. From the library's own nav. */
  section?: string;
}

// `Astro.props as Props` rather than a bare destructure: without the cast
// astro check reports Props as an unused type, and a type nothing references
// is a type that drifts away from what the pages actually pass.
const {
  title,
  description,
  current,
  libraryVersion,
  staleMarkers = [],
  headings = [],
  symbols = [],
  railForm = "headings",
  railLabel = ui.on_this_page,
  section = "",
} = Astro.props as Props;

const nav = docsNav as NavItem[];

// Reading order for prev/next is the nav's own order, flattened.
const flat: { title: string; href: string }[] = [];
const walk = (items: NavItem[]) => {
  for (const item of items) {
    if (item.href && !/^https?:\/\//.test(item.href))
      flat.push({ title: item.title, href: item.href });
    if (item.children) walk(item.children);
  }
};
walk(nav);
const here = flat.findIndex((f) => f.href === current);
const prev = here > 0 ? flat[here - 1] : undefined;
const next = here >= 0 && here < flat.length - 1 ? flat[here + 1] : undefined;

// The markdown twin: the page URL without its trailing slash, plus `.md`.
// Predictable by construction rather than by convention, and generated by an
// endpoint at build time so there is no committed second copy.
const twin = current === "/docs/" ? "/docs/index.md" : `${current.replace(/\/$/, "")}.md`;

// The migration guide is a ported page like any other, so it is only linked
// when it is actually in the corpus.
const migrationHref = flat.some((f) => f.href === "/docs/migration/")
  ? "/docs/migration/"
  : null;
---

<Base title={`${title} · reward-lens`} description={description}>
  <div class="docs" data-pagefind-meta={section ? `section:${section}` : undefined}>
    {/*
      data-pagefind-ignore, not data-pagefind-body on the article.
      data-pagefind-body is site-wide in its effect: the moment ONE page
      declares it, Pagefind indexes only pages that do, and the index dropped
      from 162 pages and 13,615 words to 100 and 8,725. Measured, not guessed.
      Ignoring the chrome gets the same result for these pages without deciding
      indexing policy for six other packets' routes from inside the docs frame.
    */}
    <div class="docs__bar" data-pagefind-ignore>
      <SearchOverlay scope={null} />
      <CopyPage href={twin} />
    </div>

    {/*
      ONE rail, placed by the grid rather than rendered twice and hidden. Two
      instances would mean one of them is display:none at every width, and
      contents-rail's acceptance criterion 3 is that it is never display:none
      at any width, checked by computed style at seven of them. Source order is
      sidebar, rail, prose; the grid moves the rail into the margin column at
      --bp-xl and leaves it above the prose everywhere else.
    */}
    <div class="docs__grid">
      <div class="docs__aside" data-pagefind-ignore>
        <DocsSidebar items={nav} current={current} />
      </div>

      <div class="docs__railslot" data-pagefind-ignore>
        <ContentsRail
          headings={headings}
          symbols={symbols}
          form={railForm}
          label={railLabel}
        />
      </div>

      <article class="docs__main">
        {/*
          One chip per page and its direction is derived, never passed. Every
          page in this corpus describes 3.0.0, which the package index has not
          seen, so every page says so: "describes 3.0.0, which has not been
          released. The version you get from the install command is 2.0.1."
          That is the fact a reader needs and it is checkable in one click.

          It does NOT say a page describes 2.0 because two of its sentences
          still mention 2.0. That would be false of a page in the 3.0 tree.
          What those pages get instead is the migration link, which is the
          actionable half, and a staleMarkers entry in their front matter,
          which is the half that goes back upstream as a library defect.
        */}
        {/*
          data-pagefind-ignore: the banner is the same two sentences on all
          eighty-four pages, and without this every search excerpt opened with
          "install command is 2.0.1". Found by driving the overlay, not by
          reading the markup.
        */}
        <div data-pagefind-ignore>
          <VersionChip
            describes={libraryVersion}
            form="banner"
            href={staleMarkers.length > 0 ? migrationHref : null}
          />
        </div>

        <slot />

        <PrevNext prev={prev} next={next} />
      </article>
    </div>
  </div>
</Base>

<script>
  // A scroll container a keyboard cannot reach is an accessibility failure,
  // and one that does not scroll is not a container. So: focusable only when it
  // actually overflows, measured rather than declared.
  //
  // The selector was `.katex-display` and it matched nothing. That class comes
  // from KaTeX's HTML renderer; this site renders MathML, where a display
  // expression is `<span class="katex"><math display="block">` and carries no
  // such class. "There is no display mathematics in the v3 tree today" was the
  // conclusion drawn from that selector, and the corpus in fact holds 21
  // expressions across 15 pages. Both selectors are here so the answer does not
  // depend on which renderer is configured.
  // setAttribute, not `el.tabIndex = 0`. `tabIndex` is a property of
  // HTMLElement and SVGElement; a MathML element is a MathMLElement and does
  // not have it, so the assignment succeeded silently and set nothing, and axe
  // reported scrollable-region-focusable on all 30 display expressions. The
  // attribute works on any element.
  //
  // `.docs-prose p > .katex:only-child` joins the list because docs-legacy.css
  // now scrolls an expression that is the only thing in its paragraph. Two of
  // those exist and both are wider than a 320px column, on
  // /docs/instruments/credit/ and /docs/instruments/heritability/, and without
  // this line axe reports scrollable-region-focusable on each of them in both
  // themes: four violations, on a ratchet that may only shrink.
  const scrollers = document.querySelectorAll(
    '.katex-display, .docs-prose math[display="block"], .docs-prose table, .docs-prose p > .katex:only-child',
  );
  for (const el of scrollers) {
    if (el.scrollWidth > el.clientWidth) el.setAttribute("tabindex", "0");
  }

  // A ported table is `display: block` so that it scrolls inside itself rather
  // than pushing the page sideways: the port emits GFM pipe tables, so there is
  // no wrapper element to put the overflow on. Chrome and Firefox still expose
  // the table semantics from the element; Safari with VoiceOver takes them from
  // the computed display and drops them. These roles are the ones it drops, and
  // they are what the element already is, so nothing here asserts a structure
  // the markup does not have.
  for (const table of document.querySelectorAll<HTMLElement>(".docs-prose table")) {
    table.setAttribute("role", "table");
    for (const el of table.querySelectorAll<HTMLElement>("thead, tbody, tfoot"))
      el.setAttribute("role", "rowgroup");
    for (const el of table.querySelectorAll<HTMLElement>("tr")) el.setAttribute("role", "row");
    for (const el of table.querySelectorAll<HTMLElement>("th"))
      el.setAttribute("role", el.closest("thead") ? "columnheader" : "rowheader");
    for (const el of table.querySelectorAll<HTMLElement>("td")) el.setAttribute("role", "cell");
  }
</script>

<style>
  .docs {
    width: 100%;
    max-width: min(var(--grid-max), 100%);
    margin-inline: auto;
    padding-inline: var(--page-pad);
    padding-block: var(--space-5) var(--space-8);
    min-width: 0;
  }

  .docs__bar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: flex-end;
    margin-block-end: var(--space-4);
    min-width: 0;
  }

  .docs__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
    min-width: 0;
  }

  .docs__main {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  .docs__main > :global(*) {
    min-width: 0;
  }

  .docs__railslot {
    min-width: 0;
  }

  /* --- two columns: sidebar and prose, the rail a row above the prose ----- */
  @media (min-width: 64rem) /* --bp-lg */ {
    .docs__grid {
      /* The sidebar track is --grid-margin-col plus --space-8, which is the
         240px the contract draws, expressed in the ramp rather than typed. */
      grid-template-columns:
        calc(var(--grid-margin-col) + var(--space-8))
        minmax(0, 1fr);
      column-gap: var(--space-7);
    }
    .docs__aside {
      grid-column: 1;
      grid-row: 1 / span 2;
    }
    .docs__railslot {
      grid-column: 2;
      grid-row: 1;
    }
    .docs__main {
      grid-column: 2;
      grid-row: 2;
    }
  }

  /* --- three columns: the rail moves into the margin --------------------- */
  @media (min-width: 75rem) /* --bp-xl */ {
    .docs__grid {
      grid-template-columns:
        calc(var(--grid-margin-col) + var(--space-8))
        minmax(0, 1fr)
        minmax(0, var(--grid-margin-col));
      column-gap: var(--grid-margin-gap);
    }
    .docs__aside {
      grid-column: 1;
      grid-row: 1;
    }
    .docs__railslot {
      grid-column: 3;
      grid-row: 1;
    }
    .docs__main {
      grid-column: 2;
      grid-row: 1;
    }
  }

  @media print {
    .docs__bar,
    .docs__aside,
    .docs__railslot {
      display: none;
    }
  }
</style>
