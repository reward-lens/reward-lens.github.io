---
import "@styles/global.css";
import NavShell from "@components/nav-shell.astro";
import SiteFooter from "@components/site-footer.astro";
import SkipLink from "@components/skip-link.astro";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
}

const { title, description, ogImage = "/og/default.png" } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogUrl = new URL(ogImage, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Runs before first paint. Two jobs.
      //
      // 1. data-theme. tokens.css carries dark on the bare :root, flips to
      //    light inside prefers-color-scheme, and lets [data-theme] override
      //    both in either direction. This line only ever states a preference
      //    that has already been chosen; with scripting off nothing is set and
      //    the OS preference governs, which is why both themes render without
      //    it.
      // 2. data-js. Controls that cannot work without scripting hide when it
      //    is absent, rather than sitting there dead.
      (() => {
        const root = document.documentElement;
        root.dataset.js = "on";
        let t;
        try {
          t = localStorage.getItem("theme");
        } catch {}
        if (t !== "dark" && t !== "light") {
          t = window.matchMedia("(prefers-color-scheme: light)").matches
            ? "light"
            : "dark";
        }
        root.dataset.theme = t;
      })();
    </script>

    <!-- Four faces, two families, latin subset, woff2 only. @font-face rules
         are in src/styles/fonts.css; these preloads are the same four files. -->
    <link
      rel="preload"
      href="/fonts/ibm-plex-sans-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/ibm-plex-sans-latin-600-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/ibm-plex-mono-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/ibm-plex-mono-latin-500-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
    <!-- Analytics intentionally absent, and the footer says so. -->
  </head>
  <body>
    <SkipLink />
    <NavShell />
    {/* tabindex="-1" and not decoration. A fragment link to a non-focusable
        element sets the sequential focus navigation starting point but leaves
        document.activeElement on <body>, so the next Tab lands in the right
        place while a screen reader's virtual cursor has not moved and the
        reader is told nothing. -1 makes <main> a programmatic focus target
        without adding a tab stop. */}
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
    <script>
      // Keep themed figures in sync with the manual theme toggle. The
      // <picture> prefers-color-scheme source handles the no-JS case; once JS
      // runs, the data-theme attribute is authoritative.
      const syncFigures = () => {
        const theme = document.documentElement.dataset.theme ?? "dark";
        document
          .querySelectorAll<HTMLImageElement>("img.themed-img")
          .forEach((img) => {
            const want = img.dataset[theme];
            if (!want) return;
            img
              .closest("picture")
              ?.querySelectorAll("source")
              .forEach((s) => s.remove());
            if (img.getAttribute("src") !== want) img.src = want;
          });
      };
      new MutationObserver(syncFigures).observe(document.documentElement, {
        attributes: true,
        attributeFilter: ["data-theme"],
      });
      syncFigures();
    </script>
  </body>
</html>
