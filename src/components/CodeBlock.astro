---
// CodeBlock: a filename header and a copy button wrapped around a slotted code
// block. The slot may be a pre-rendered highlighted block or plain text.

interface Props {
  filename?: string;
  lang?: string;
}

const { filename, lang } = Astro.props;
---

<figure class="codeblock">
  {
    (filename || lang) && (
      <figcaption class="cb-head">
        {filename && <span class="cb-file">{filename}</span>}
        {lang && !filename && <span class="cb-lang">{lang}</span>}
        {lang && filename && <span class="cb-lang">{lang}</span>}
        <button type="button" class="cb-copy" aria-label="Copy code">
          Copy
        </button>
      </figcaption>
    )
  }
  <div class="cb-body scroll-x">
    <slot />
  </div>
  {
    !filename && !lang && (
      <button type="button" class="cb-copy cb-copy-float" aria-label="Copy code">
        Copy
      </button>
    )
  }
</figure>

<style>
  .codeblock {
    margin: var(--sp-6) 0;
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    background: var(--code-bg);
    overflow: hidden;
    position: relative;
  }
  .cb-head {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    padding: var(--sp-2) var(--sp-3);
    border-bottom: 1px solid var(--line);
    background: var(--bg-inset);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }
  .cb-file {
    color: var(--ink-2);
  }
  .cb-lang {
    color: var(--ink-3);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .cb-copy {
    margin-left: auto;
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    color: var(--ink-2);
    background: var(--bg-raised);
    border: 1px solid var(--line);
    border-radius: var(--r-chip);
    padding: 2px var(--sp-2);
    cursor: pointer;
    transition: border-color 150ms ease, color 150ms ease;
  }
  .cb-copy:hover {
    color: var(--ink);
    border-color: var(--line-strong);
  }
  .cb-copy-float {
    position: absolute;
    top: var(--sp-2);
    right: var(--sp-2);
  }
  .cb-body {
    padding: var(--sp-3) var(--sp-4);
  }
  .cb-body :global(pre) {
    margin: 0;
    background: transparent !important;
    border: 0 !important;
    padding: 0 !important;
  }
  .cb-body {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--ink);
    white-space: pre;
    tab-size: 2;
  }
</style>

<script>
  document.addEventListener("click", async (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(
      ".codeblock .cb-copy",
    );
    if (!btn) return;
    const fig = btn.closest(".codeblock");
    const body = fig?.querySelector(".cb-body");
    const text = body?.textContent ?? "";
    try {
      await navigator.clipboard.writeText(text.replace(/\n$/, ""));
      const prev = btn.textContent;
      btn.textContent = "Copied";
      window.setTimeout(() => {
        btn.textContent = prev;
      }, 1600);
    } catch {
      btn.textContent = "Copy failed";
    }
  });
</script>
