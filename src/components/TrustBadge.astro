---
// TrustBadge: the evidence trust tier as a single neutral letter (E/C/R/A),
// optionally with its full word. Neutral styling only; trust is not a status.
// The full word is always available in the title attribute.

interface Props {
  trust:
    | "EXPLORATORY"
    | "CALIBRATED"
    | "REGISTERED"
    | "ADJUDICATED"
    | "E"
    | "C"
    | "R"
    | "A";
  word?: boolean;
}

const { trust, word = false } = Astro.props;

const WORDS: Record<string, string> = {
  E: "Exploratory",
  C: "Calibrated",
  R: "Registered",
  A: "Adjudicated",
};

const letter = trust.charAt(0).toUpperCase();
const fullWord = WORDS[letter] ?? trust;
---

<span class="trust" title={fullWord}>
  <span class="trust-letter" aria-hidden={word ? "true" : undefined}>{letter}</span>
  {word && <span class="trust-word">{fullWord}</span>}
  {!word && <span class="visually-hidden">{fullWord}</span>}
</span>

<style>
  .trust {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-1);
    vertical-align: baseline;
    font-family: var(--font-mono);
  }
  .trust-letter {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.15em;
    height: 1.15em;
    padding: 0 3px;
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--ink-2);
    background: var(--bg-inset);
    border: 1px solid var(--line-strong);
    border-radius: var(--r-chip);
    line-height: 1;
  }
  .trust-word {
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    color: var(--ink-2);
  }
</style>
