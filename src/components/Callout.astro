---
/**
 * The ported corpus's admonition. Thirty-two pages import it and nothing else
 * on the site does: scripts/port_docs.py turns the library's `!!! note`,
 * `!!! warning`, `!!! tip`, `!!! important` and `!!! danger` blocks into this,
 * which is why it takes five types where design/components/callout.md takes
 * three variants and a copy.yaml label.
 *
 * Rewritten, and two of the three reasons are site rules it was breaking:
 *
 *  - IT DREW A WARNING TRIANGLE, on twenty-seven blocks. callout.md is
 *    explicit that there is no icon, ever: every callout system drifts toward
 *    coloured boxes with icons and once there are four of them a reader stops
 *    reading any of them. HANDOFF.md rule 4 makes the same point about
 *    refusals, and a triangle beside library prose that is describing careful
 *    measurement reads as an error either way.
 *  - It coloured its edge with --accent and --info. Neither exists in this
 *    palette: the palette has no brand accent and spends colour only on data
 *    (D-30), and --accent is a compat-v1.css alias Q1 deletes.
 *  - Its five types produced five treatments. They produce one: a leading rule
 *    and a label, which is the register callout.astro already established.
 *
 * The label is the library's own admonition title. When a block has none, this
 * renders none, rather than falling back to a word this site would have had to
 * invent. That is why the `labels` table is gone.
 */
interface Props {
  type?: "note" | "info" | "warn" | "important" | "tip";
  title?: string;
}
const { type = "note", title } = Astro.props;
const label = title && title.trim() !== "" ? title : null;
---

<aside class:list={["adm", `adm--${type}`]}>
  {label && <p class="adm__label type-mono-label">{label}</p>}
  <div class="adm__body type-body-sm"><slot /></div>
</aside>

<style>
  .adm {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    /* No fill and no icon. The rule is the whole treatment, the same one
       callout.astro uses, so a callout in ported prose and a callout in site
       prose read as the same object. */
    border-inline-start: var(--border-w-accent) solid var(--line-strong);
    padding-inline-start: var(--space-4);
    margin-block: var(--space-5);
    min-width: 0;
    max-inline-size: min(var(--measure-prose), 100%);
  }
  .adm__label {
    color: var(--ink-2);
    margin: 0;
  }
  .adm__body {
    color: var(--ink-2);
    min-width: 0;
  }
  .adm__body :global(p:first-child) {
    margin-block-start: 0;
  }
  .adm__body :global(p:last-child) {
    margin-block-end: 0;
  }
  .adm__body :global(pre) {
    overflow-x: auto;
    max-inline-size: 100%;
  }
</style>
