---
// Callout: a quiet bordered aside in the info color family (never a status
// color). Each type carries a small inline SVG glyph, no emoji.

interface Props {
  type?: "note" | "info" | "warn" | "important" | "tip";
  title?: string;
}
const { type = "note", title } = Astro.props;
const labels: Record<string, string> = {
  note: "Note",
  info: "Info",
  warn: "Warning",
  important: "Important",
  tip: "Tip",
};
// note/info/tip share the info family; warn/important lean on the accent edge.
const glyph: Record<string, "info" | "warn" | "tip"> = {
  note: "info",
  info: "info",
  tip: "tip",
  warn: "warn",
  important: "warn",
};
const g = glyph[type];
---

<aside class={`callout callout-${type}`}>
  <span class="callout-icon" aria-hidden="true">
    {
      g === "info" && (
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="9" />
          <path d="M12 11v5" />
          <path d="M12 7.5v.01" />
        </svg>
      )
    }
    {
      g === "warn" && (
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 3 2.5 20h19L12 3Z" />
          <path d="M12 10v4" />
          <path d="M12 17.5v.01" />
        </svg>
      )
    }
    {
      g === "tip" && (
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 18h6" />
          <path d="M10 21h4" />
          <path d="M12 3a6 6 0 0 0-3.5 10.9c.5.4.8.9.9 1.5l.1.6h5l.1-.6c.1-.6.4-1.1.9-1.5A6 6 0 0 0 12 3Z" />
        </svg>
      )
    }
  </span>
  <div class="callout-content">
    {title !== "" && <p class="callout-title">{title ?? labels[type]}</p>}
    <div class="callout-body"><slot /></div>
  </div>
</aside>

<style>
  .callout {
    display: flex;
    gap: var(--sp-3);
    border: 1px solid var(--line);
    border-left: 3px solid var(--info);
    border-radius: var(--r-card);
    background: var(--bg-raised);
    padding: var(--sp-3) var(--sp-4);
    margin: var(--sp-6) 0;
    font-size: var(--text-sm);
  }
  .callout-warn,
  .callout-important {
    border-left-color: var(--accent);
  }
  .callout-icon {
    flex: none;
    display: inline-flex;
    margin-top: 1px;
    color: var(--info);
  }
  .callout-warn .callout-icon,
  .callout-important .callout-icon {
    color: var(--accent);
  }
  .callout-content {
    min-width: 0;
  }
  .callout-title {
    margin: 0 0 var(--sp-1);
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: var(--text-sm);
    color: var(--ink);
  }
  .callout-body {
    color: var(--ink-2);
  }
  .callout-body :global(p:first-child) {
    margin-top: 0;
  }
  .callout-body :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
