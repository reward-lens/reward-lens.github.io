---
// VerdictChip: an outcome rendered as a pill carrying a colour, a glyph and the
// word together. Colour never appears without the word.
//
// NOT IMPORTED BY ANYTHING today. Its four words are already the public
// vocabulary the repositioning asks for, so unlike KillBadge it is a component
// to keep: `confirmed / refuted / mixed / inconclusive` say what happened,
// where `adjudicated` says only that a process ran. Its words are typed here
// rather than read from copy.yaml, which is the one thing about it that has to
// change before it renders anywhere.

interface Props {
  verdict: "confirmed" | "refuted" | "mixed" | "inconclusive";
  compact?: boolean;
}

const { verdict, compact = false } = Astro.props;

const MAP: Record<string, { glyph: string; word: string }> = {
  confirmed: { glyph: "✓", word: "Confirmed" },
  refuted: { glyph: "✕", word: "Refuted" },
  mixed: { glyph: "◐", word: "Mixed" },
  inconclusive: { glyph: "○", word: "Inconclusive" },
};

const { glyph, word } = MAP[verdict] ?? MAP.inconclusive;
---

<span class={`verdict verdict-${verdict}${compact ? " is-compact" : ""}`}>
  <span class="verdict-glyph" aria-hidden="true">{glyph}</span>
  <span class="verdict-word">{word}</span>
</span>

<style>
  .verdict {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-1);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: 1.2;
    padding: 2px var(--sp-2);
    border: 1px solid;
    border-radius: var(--r-pill);
    white-space: nowrap;
    vertical-align: baseline;
  }
  .verdict.is-compact {
    font-size: var(--text-xs);
    padding: 1px var(--sp-2);
  }
  .verdict-glyph {
    font-size: 0.95em;
    line-height: 1;
  }

  .verdict-confirmed {
    color: var(--ok-ink);
    border-color: color-mix(in oklab, var(--ok) 55%, transparent);
    background: color-mix(in oklab, var(--ok) 6%, transparent);
  }
  .verdict-refuted {
    color: var(--bad-ink);
    border-color: color-mix(in oklab, var(--bad) 55%, transparent);
    background: color-mix(in oklab, var(--bad) 6%, transparent);
  }
  .verdict-mixed {
    color: var(--mix-ink);
    border-color: color-mix(in oklab, var(--mix) 55%, transparent);
    background: color-mix(in oklab, var(--mix) 6%, transparent);
  }
  .verdict-inconclusive {
    color: var(--none-ink);
    border-color: color-mix(in oklab, var(--none) 55%, transparent);
    background: color-mix(in oklab, var(--none) 6%, transparent);
  }
</style>
