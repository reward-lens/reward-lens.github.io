---
import ThemeToggle from "./ThemeToggle.astro";
import { nav } from "../copy";

// NOT IMPORTED BY ANYTHING. The shell that renders is `nav-shell.astro`, from
// `layouts/Base.astro`. This is the v1 header, kept because deleting one of a
// duplicate pair is how a route nobody was looking at stops building, and left
// here with a note instead so the next reader does not have to work that out.
//
// Its four typed sections were `/campaign/` "Campaign", `/atlas/`, `/docs/` and
// `/science/` "Science". Two of those routes are now redirect stubs, and
// `Campaign` was primary navigation for an archive. They are replaced by
// `nav.primary` from copy.yaml, which is the one place the site's navigation is
// written, so this file cannot drift from the live shell again.
const sections = nav.primary;
const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="wordmark" aria-label="reward-lens home">
      <img
        src="/brand/wordmark-dark.svg"
        alt=""
        class="wordmark-img wm-dark"
        width="120"
        height="22"
      />
      <img
        src="/brand/wordmark-light.svg"
        alt=""
        class="wordmark-img wm-light"
        width="120"
        height="22"
      />
      <span class="visually-hidden">reward-lens</span>
    </a>

    <nav class="desktop-nav" aria-label="Main">
      {
        sections.map((s) => (
          <a
            href={s.href}
            aria-current={path.startsWith(s.href) ? "page" : undefined}
          >
            {s.label}
          </a>
        ))
      }
    </nav>

    <div class="header-actions">
      <a
        href="https://github.com/reward-lens/reward-lens"
        class="gh-link"
        aria-label="reward-lens on GitHub"
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 16 16"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"
          ></path>
        </svg>
      </a>
      <ThemeToggle />

      <details class="mobile-menu">
        <summary aria-label="Open menu">
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M3 6h18M3 12h18M3 18h18"></path>
          </svg>
        </summary>
        <nav class="mobile-nav" aria-label="Main, mobile">
          {sections.map((s) => <a href={s.href}>{s.label}</a>)}
          <a href="https://github.com/reward-lens/reward-lens">GitHub</a>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--line);
    background: var(--bg-page);
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .header-inner {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 0 var(--page-pad);
    height: 56px;
    display: flex;
    align-items: center;
    gap: var(--sp-6);
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }
  .wordmark-img {
    height: 22px;
    width: auto;
    display: block;
  }
  /* Wordmark is loaded as <img>, so currentColor cannot inherit. Ship both
     theme variants and toggle by the data-theme attribute the head script
     always sets, so a manual theme toggle swaps them too. */
  .wm-dark {
    display: none;
  }
  .wm-light {
    display: block;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .wm-dark {
      display: block;
    }
    :global(:root:not([data-theme="light"])) .wm-light {
      display: none;
    }
  }
  :global(:root[data-theme="dark"]) .wm-dark {
    display: block;
  }
  :global(:root[data-theme="dark"]) .wm-light {
    display: none;
  }
  .desktop-nav {
    display: flex;
    gap: var(--sp-6);
    margin-left: auto;
  }
  .desktop-nav a {
    color: var(--ink-2);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: 600;
    padding: var(--sp-2) 0;
  }
  .desktop-nav a:hover {
    color: var(--ink);
  }
  .desktop-nav a[aria-current="page"] {
    color: var(--ink);
    box-shadow: inset 0 -2px 0 var(--accent);
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
  }
  .gh-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    color: var(--ink-2);
    border-radius: var(--r-card);
  }
  .gh-link:hover {
    color: var(--ink);
  }

  .mobile-menu {
    display: none;
  }
  .mobile-menu summary {
    list-style: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    color: var(--ink-2);
    cursor: pointer;
  }
  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }
  .mobile-nav {
    position: fixed;
    inset: 56px 0 0 0;
    background: var(--bg-page);
    display: flex;
    flex-direction: column;
    padding: var(--sp-6) var(--page-pad);
    gap: var(--sp-2);
    z-index: 60;
  }
  .mobile-nav a {
    color: var(--ink);
    text-decoration: none;
    font-size: var(--text-lg);
    font-weight: 600;
    padding: var(--sp-3) 0;
    border-bottom: 1px solid var(--line);
    min-height: 44px;
  }

  @media (max-width: 760px) {
    .desktop-nav {
      display: none;
    }
    .header-actions {
      margin-left: auto;
    }
    .mobile-menu {
      display: block;
    }
    .gh-link {
      display: none;
    }
  }
</style>
