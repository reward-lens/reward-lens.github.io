---
/**
 * nav-tree  ·  the recursive list body of docs-sidebar.
 *
 * Not a public component. It exists so the wide-screen sidebar and the
 * narrow-screen picker render ONE tree into two containers, which is how the
 * collapse needs no script and does not depend on overriding native <details>
 * content hiding, a thing browsers do not let you do reliably.
 *
 * All styling lives in docs-sidebar.astro, because this file is rendered into
 * that component's subtree and scoped styles do not cross the boundary.
 */
import type { NavItem } from "./types";

interface Props {
  items: NavItem[];
  current: string;
  /** Recursion only. A page never passes this. */
  depth?: number;
}

const { items, current, depth = 0 } = Astro.props;

const isExternal = (href?: string) => !!href && /^https?:\/\//.test(href);

/** True when this item or anything under it is the current page. Used to lift
 *  an ancestor group title, so a tree still says where you are. */
const holdsCurrent = (item: NavItem): boolean =>
  item.href === current || (item.children ?? []).some(holdsCurrent);

// components/docs-sidebar.md, the Empty row: a group with no children and no
// href fails the build, naming the title. The generated tree has four inhabited
// shapes and this is not one of them, so it means the port produced a node
// nothing can reach.
for (const item of items) {
  if (!item.href && !(item.children && item.children.length)) {
    throw new Error(
      `docs-sidebar: the nav item "${item.title}" has neither an href nor ` +
        `children, so nothing can reach it. components/docs-sidebar.md, ` +
        `the Empty row. src/data/docs-nav.json is generated by ` +
        `scripts/port_docs.py from the library's own mkdocs nav.`,
    );
  }
}
---

<ul class:list={["dnav__list", depth > 0 && "dnav__list--nested"]}>
  {
    items.map((item) =>
      item.children && item.children.length ? (
        <li class="dnav__group">
          {item.href ? (
            <a
              class:list={[
                "dnav__title",
                "dnav__title--link",
                "type-mono-label",
                holdsCurrent(item) && "is-ancestor",
              ]}
              href={item.href}
              aria-current={item.href === current ? "page" : undefined}
            >
              {item.title}
            </a>
          ) : (
            <span
              class:list={[
                "dnav__title",
                "type-mono-label",
                holdsCurrent(item) && "is-ancestor",
              ]}
            >
              {item.title}
            </span>
          )}
          <Astro.self items={item.children} current={current} depth={depth + 1} />
        </li>
      ) : (
        <li class="dnav__leaf">
          {/*
            No target="_blank". components/docs-sidebar.md asks for a visually
            hidden "opens in a new tab" *if* target is set; copy.yaml has no
            such string and HANDOFF.md rule 1 forbids writing one. F1 already
            settled the same question the same way: site-footer.astro links the
            repository and the package index in the same tab. So the marker is
            the arrow, which is decoration and is hidden, and there is nothing
            to announce.
          */}
          <a
            class="dnav__link type-body-sm"
            href={item.href}
            aria-current={item.href === current ? "page" : undefined}
            rel={isExternal(item.href) ? "noreferrer" : undefined}
          >
            <span class="dnav__text">{item.title}</span>
            {isExternal(item.href) && (
              <span class="dnav__ext" aria-hidden="true">
                ↗
              </span>
            )}
          </a>
        </li>
      ),
    )
  }
</ul>
