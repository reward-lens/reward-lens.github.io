---
/**
 * docs-sidebar  ·  design/components/docs-sidebar.md
 *
 * Where you are in ninety pages, and how to reach any of the others.
 *
 * One tree, two containers, no JavaScript. At any width exactly one container
 * is display:none and therefore out of the accessibility tree, so the duplicate
 * costs bytes and exposes nothing twice. The alternative is a scripted
 * disclosure and the build order puts the static version first.
 *
 * Nobody authors the tree. It is src/data/docs-nav.json, generated by
 * scripts/port_docs.py from the library's own mkdocs `nav:`, which is what
 * lets D-04's repoint at the v3 corpus carry the sidebar with it.
 *
 * The current marker is --ink plus an inset leading rule, NOT a colour. The
 * legacy SectionNavTree used --accent, which does not exist in this palette:
 * the palette has no brand accent and spends colour only on data (D-30), and
 * --accent is a compat-v1.css alias Q1 deletes.
 */
import NavTree from "./nav-tree.astro";
import type { NavItem } from "./types";
import { ui } from "../../copy";

interface Props {
  items: NavItem[];
  /** The current route path, WITH its trailing slash. */
  current: string;
  class?: string;
}

const { items, current, class: extraClass = "" } = Astro.props;

// components/docs-sidebar.md, the Error row. astro.config.mjs sets
// trailingSlash:"always" and the comparison is item.href === current, so a
// current computed without its slash drops the current-page state on every
// page with no error anywhere. Failing here is the whole reason that row says
// "fails the build" rather than "renders nothing marked".
const hrefs = new Set<string>();
const walk = (list: NavItem[]) => {
  for (const item of list) {
    if (item.href) hrefs.add(item.href);
    if (item.children) walk(item.children);
  }
};
walk(items);

if (!hrefs.has(current)) {
  throw new Error(
    `docs-sidebar: current="${current}" matches no entry in docs-nav.json, so ` +
      `no link would be marked and nothing would say so. ` +
      `components/docs-sidebar.md, the Error row. Most likely cause: a route ` +
      `computed without its trailing slash, which trailingSlash:"always" makes ` +
      `invisible everywhere else.`,
  );
}

const pickerId = "docs-picker-summary";
---

<div class:list={["dnav", extraClass]}>
  {/* Wide: the sidebar itself. Named from copy.yaml. */}
  <nav class="dnav__wide" aria-label={ui.on_this_section}>
    <NavTree items={items} current={current} />
  </nav>

  {/*
    Narrow: the same tree inside a <details>, so it opens with scripting off.
    It pushes the page down rather than overlaying it, because an overlay over
    prose on a phone is a modal nobody asked for and it needs script to close.

    The inner <nav> takes its name from its own <summary> rather than a second
    copy.yaml key. copy.yaml has no distinct accessible name for the picker,
    the contract asks for two names, and an accessible name that IS the visible
    label is the better of the two answers anyway. Only ever one of these two
    containers is in the accessibility tree, so there is no ambiguity to fix.
  */}
  <details class="dnav__picker">
    <summary class="dnav__summary type-body-sm" id={pickerId}>
      <span>{ui.on_this_section}</span>
      <span class="dnav__chevron" aria-hidden="true"></span>
    </summary>
    <nav class="dnav__picker-body" aria-labelledby={pickerId}>
      <NavTree items={items} current={current} />
    </nav>
  </details>
</div>

<script>
  // The corpus is a hundred entries and the tree renders in full, so on a page
  // deep in the nav the current link is below the sidebar's own scroll box and
  // a reader arrives with no idea where they are. Found by looking at the
  // 1440 screenshot, not by reading the code.
  //
  // This scrolls the sidebar's own overflow, never the page: `nearest` with a
  // scroll container that is already scrollable moves the container. With
  // scripting off the tree is unchanged and every link still works, which is
  // why this is an enhancement and not a fix.
  const wide = document.querySelector<HTMLElement>(".dnav__wide");
  const here = wide?.querySelector<HTMLElement>('[aria-current="page"]');
  if (wide && here && wide.scrollHeight > wide.clientHeight) {
    const top = here.offsetTop - wide.clientHeight / 2;
    wide.scrollTop = Math.max(0, top);
  }
</script>

<style>
  .dnav {
    min-width: 0;
  }

  /* --- the tree, shared by both containers ------------------------------- */
  .dnav :global(.dnav__list) {
    list-style: none;
    margin: 0;
    padding: 0;
    min-width: 0;
  }
  .dnav :global(.dnav__list--nested) {
    margin-block-start: var(--space-1);
  }
  .dnav :global(.dnav__group) {
    margin-block-end: var(--space-5);
  }
  .dnav :global(.dnav__group .dnav__group) {
    margin-block-end: var(--space-3);
  }

  /* Group titles. --ink-3 is permitted here: this component paints no surface
     and sits on --ground, where it is 5.25:1. */
  .dnav :global(.dnav__title) {
    display: block;
    color: var(--ink-3);
    padding-block: var(--space-1);
    margin-block-end: var(--space-1);
    overflow-wrap: anywhere;
  }
  .dnav :global(.dnav__title--link) {
    text-decoration: none;
  }
  .dnav :global(.dnav__title--link:hover) {
    color: var(--ink-2);
    text-decoration-line: underline;
  }
  /* A collapsed tree still says where you are: the ancestor of the current
     page lifts one step. */
  .dnav :global(.dnav__title.is-ancestor) {
    color: var(--ink-2);
  }

  .dnav :global(.dnav__link) {
    display: flex;
    align-items: baseline;
    gap: var(--space-1);
    color: var(--ink-2);
    text-decoration: none;
    padding: var(--space-1) var(--space-3);
    /* The marker is space, held open on every link so the current one does not
       shift its neighbours when it gains a rule. */
    border-inline-start: var(--border-w-accent) solid transparent;
    min-width: 0;
    transition: color var(--dur-1) var(--curve-ui);
  }
  .dnav :global(.dnav__text) {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .dnav :global(.dnav__link:hover) {
    color: var(--ink);
    text-decoration-line: underline;
  }
  .dnav :global(.dnav__link:focus-visible) {
    outline: var(--focus-width) solid var(--focus);
    outline-offset: var(--focus-offset);
  }
  .dnav :global(.dnav__link[aria-current="page"]) {
    color: var(--ink);
    font-weight: 600;
    border-inline-start-color: var(--ink);
  }
  .dnav :global(.dnav__ext) {
    color: var(--ink-3);
  }

  /* --- the two containers ------------------------------------------------ */
  .dnav__wide {
    position: sticky;
    /* The header is sticky; the sidebar starts below it and scrolls its own
       overflow rather than the page's. */
    top: var(--space-7);
    max-block-size: calc(100dvh - var(--space-9));
    overflow-y: auto;
    overscroll-behavior: contain;
    padding-block-end: var(--space-5);
    min-width: 0;
  }

  .dnav__picker {
    display: none;
    border: var(--border-w) solid var(--line);
    border-radius: var(--radius-2);
    margin-block-end: var(--space-6);
    min-width: 0;
  }
  .dnav__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    /* 48px, per the contract, from the ramp rather than a literal. */
    min-block-size: var(--space-7);
    padding-inline: var(--space-4);
    color: var(--ink);
    cursor: pointer;
    list-style: none;
  }
  .dnav__summary::-webkit-details-marker {
    display: none;
  }
  .dnav__summary:focus-visible {
    outline: var(--focus-width) solid var(--focus);
    outline-offset: var(--focus-offset);
  }
  /* A chevron drawn from the current text colour: a glyph would need a string
     and a font, and a rotated square needs neither. */
  .dnav__chevron {
    inline-size: var(--space-2);
    block-size: var(--space-2);
    border-inline-end: var(--border-w-accent) solid currentColor;
    border-block-end: var(--border-w-accent) solid currentColor;
    transform: rotate(45deg);
    transform-origin: center;
    color: var(--ink-3);
    flex: none;
    transition: transform var(--dur-1) var(--curve-ui);
  }
  .dnav__picker[open] .dnav__chevron {
    transform: rotate(-135deg);
  }
  .dnav__picker[open] .dnav__summary {
    border-block-end: var(--border-w) solid var(--line);
  }
  .dnav__picker-body {
    padding: var(--space-3) var(--space-2);
  }
  .dnav__picker-body :global(.dnav__link) {
    min-block-size: var(--space-6);
    align-items: center;
  }

  /* Three columns at --bp-xl, two at --bp-lg, one below it. The sidebar does
     not vanish below --bp-lg: it becomes the picker. That is what "collapses
     deliberately" means, and it is the difference between a layout and a set
     of display:none. */
  @media (max-width: 63.9375rem) /* --bp-lg minus one pixel */ {
    .dnav__wide {
      display: none;
    }
    .dnav__picker {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dnav__chevron {
      transition: none;
    }
  }
</style>
