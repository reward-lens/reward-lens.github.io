---
// SectionNav: the docs sidebar. On wide screens it is a plain nested sidebar;
// below 900px it becomes an "On this section" details picker, closed by
// default. Two containers share one recursive list (SectionNavTree) so the
// collapse needs no JavaScript and does not depend on overriding native
// details content-hiding (which browsers do not let you override reliably).

import SectionNavTree from "./SectionNavTree.astro";

interface NavItem {
  title: string;
  href?: string;
  children?: NavItem[];
}
interface Props {
  items: NavItem[];
  current: string;
}

const { items, current } = Astro.props;
---

<div class="section-nav">
  <nav class="sn-desktop" aria-label="Section">
    <SectionNavTree items={items} current={current} />
  </nav>

  <details class="sn-mobile">
    <summary class="sn-summary">On this section</summary>
    <nav class="sn-mobile-body" aria-label="Section">
      <SectionNavTree items={items} current={current} />
    </nav>
  </details>
</div>

<style>
  .section-nav {
    font-family: var(--font-ui);
    font-size: var(--text-sm);
  }

  .sn-mobile {
    display: none;
  }

  @media (max-width: 899.98px) {
    .sn-desktop {
      display: none;
    }
    .sn-mobile {
      display: block;
      border: 1px solid var(--line);
      border-radius: var(--r-card);
      background: var(--bg-raised);
      margin-bottom: var(--sp-6);
    }
    .sn-summary {
      cursor: pointer;
      list-style: none;
      padding: var(--sp-3) var(--sp-4);
      font-weight: 600;
      color: var(--ink);
      min-height: 44px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .sn-summary::-webkit-details-marker {
      display: none;
    }
    .sn-summary::after {
      content: "＋";
      color: var(--ink-3);
    }
    .sn-mobile[open] .sn-summary::after {
      content: "－";
    }
    .sn-mobile[open] .sn-summary {
      border-bottom: 1px solid var(--line);
    }
    .sn-mobile-body {
      padding: var(--sp-3) var(--sp-2);
    }
    .sn-mobile-body :global(.nav-link) {
      min-height: 40px;
    }
  }
</style>
