---
// SectionNav: the docs sidebar. Renders groups with headings and their links,
// marks the current page with an accent inset, and flags external links. Below
// 900px it collapses into an "On this section" details picker at the top of the
// content, with no JavaScript: the body is force-shown on wide screens and left
// to the native details behaviour on narrow ones.

interface NavItem {
  title: string;
  href?: string;
  children?: NavItem[];
}
interface Props {
  items: NavItem[];
  current: string;
}

const { items, current } = Astro.props;
const isExternal = (href?: string) => !!href && /^https?:\/\//.test(href);
---

<details class="section-nav">
  <summary class="section-nav-summary">On this section</summary>
  <nav class="section-nav-body" aria-label="Section">
    <ul class="nav-list">
      {
        items.map((item) =>
          item.children && item.children.length ? (
            <li class="nav-group">
              {item.href ? (
                <a
                  class="nav-group-title nav-group-link"
                  href={item.href}
                  aria-current={item.href === current ? "page" : undefined}
                >
                  {item.title}
                </a>
              ) : (
                <span class="nav-group-title">{item.title}</span>
              )}
              <ul class="nav-sublist">
                {item.children.map((child) => (
                  <li>
                    <a
                      class="nav-link"
                      href={child.href}
                      aria-current={child.href === current ? "page" : undefined}
                      target={isExternal(child.href) ? "_blank" : undefined}
                      rel={isExternal(child.href) ? "noreferrer" : undefined}
                    >
                      {child.title}
                      {isExternal(child.href) && (
                        <span class="nav-ext" aria-hidden="true">↗</span>
                      )}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ) : (
            <li>
              <a
                class="nav-link nav-top"
                href={item.href}
                aria-current={item.href === current ? "page" : undefined}
                target={isExternal(item.href) ? "_blank" : undefined}
                rel={isExternal(item.href) ? "noreferrer" : undefined}
              >
                {item.title}
                {isExternal(item.href) && (
                  <span class="nav-ext" aria-hidden="true">↗</span>
                )}
              </a>
            </li>
          ),
        )
      }
    </ul>
  </nav>
</details>

<style>
  .section-nav {
    font-family: var(--font-ui);
    font-size: var(--text-sm);
  }
  .section-nav-summary {
    display: none;
  }
  .nav-list,
  .nav-sublist {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-group {
    margin-bottom: var(--sp-4);
  }
  .nav-group-title {
    display: block;
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ink-3);
    padding: var(--sp-1) 0;
    margin-bottom: var(--sp-1);
  }
  .nav-group-link {
    text-decoration: none;
  }
  .nav-group-link:hover {
    color: var(--ink-2);
  }
  .nav-link {
    display: flex;
    align-items: center;
    gap: var(--sp-1);
    color: var(--ink-2);
    text-decoration: none;
    padding: var(--sp-1) var(--sp-3);
    border-left: 2px solid transparent;
    line-height: 1.4;
    transition: color 150ms ease, border-color 150ms ease;
  }
  .nav-top {
    padding-left: var(--sp-3);
  }
  .nav-link:hover {
    color: var(--ink);
  }
  .nav-link[aria-current="page"] {
    color: var(--ink);
    font-weight: 600;
    border-left-color: var(--accent);
  }
  .nav-ext {
    font-size: 0.85em;
    color: var(--ink-3);
  }

  /* Wide screens: force the nav body visible regardless of details state and
     hide the summary, so it reads as a plain sidebar. */
  @media (min-width: 900px) {
    .section-nav-summary {
      display: none;
    }
    .section-nav-body {
      display: block !important;
    }
  }

  /* Narrow screens: it becomes a real collapsible picker. */
  @media (max-width: 899.98px) {
    .section-nav {
      border: 1px solid var(--line);
      border-radius: var(--r-card);
      background: var(--bg-raised);
      margin-bottom: var(--sp-6);
    }
    .section-nav-summary {
      display: block;
      cursor: pointer;
      list-style: none;
      padding: var(--sp-3) var(--sp-4);
      font-weight: 600;
      color: var(--ink);
      min-height: 44px;
    }
    .section-nav-summary::-webkit-details-marker {
      display: none;
    }
    .section-nav-summary::after {
      content: "＋";
      float: right;
      color: var(--ink-3);
    }
    .section-nav[open] .section-nav-summary::after {
      content: "－";
    }
    .section-nav[open] .section-nav-summary {
      border-bottom: 1px solid var(--line);
    }
    .section-nav-body {
      padding: var(--sp-3) var(--sp-2);
    }
    .nav-link {
      min-height: 40px;
    }
  }
</style>
