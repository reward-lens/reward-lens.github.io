---
/**
 * act-meta  ·  the margin column's contents, DESIGN.md §7.1
 *
 * A real grid track, 9.5rem wide with a 2.75rem gap, right-aligned, set in
 * mono-sm. It carries metadata a reader needs: the subject, the sample size,
 * the access level, the trust level, the reproduction status.
 *
 * IT NEVER CARRIES A DECORATIVE LABEL. §7.1 states the test and it is worth
 * repeating at the point of use, because this is the component that would
 * otherwise accumulate them: if the string would be equally true on another
 * page, it does not belong here. "Act 2" passes that test. "3 / 6" and
 * "THE INSTRUMENT" fail it, which is why act-section renders no part label.
 *
 * Below --bp-md it becomes a wrapped metadata row above the content, in the
 * same type, left-aligned, label and value side by side. Verified against
 * design/dossier/specimen-390.png.
 *
 * The label is --ink-2 and the value --ink-3. §7.1's sentence says the column
 * is "set in mono-sm at --ink-3", and the rendered specimen draws the label a
 * step brighter than its value; without that step a stacked pair reads as two
 * values. Both are permitted here: the margin sits on --ground, where --ink-3
 * is 5.25:1 (GROUND-TRUTH.md C-15).
 */
import ActSource from "@components/acts/act-source.astro";
import { ui } from "../../copy";

export interface MetaItem {
  /** What the value is. From copy.yaml, or a field name from generated data. */
  label: string;
  /**
   * The value itself. From generated data, never typed into a route. A null is
   * a fact ("not measured", copy.yaml:ui.no_value) and is rendered as one; it
   * is never blank, because a blank field and a measured zero look identical
   * and mean opposite things.
   */
  value: string | number | null;
  /**
   * Added in the route pass. A NUMBER in the margin is a rendered number like
   * any other, and gate 5 walks every text node in dist/: the shell pass put
   * the rollout count and the step count here as plain text, which is an
   * unbound numeral on the one site whose rule is that there are none. A margin
   * item carrying a numeral therefore carries its citation too, and the margin
   * refuses the item rather than rendering it bare.
   *
   * Act one and act three use `evidenceId` instead, through provenance-chip, at
   * the point of use. This is D-35's weaker grade and it exists for /see/run/.
   */
  source?: { document: string; line: number } | null;
}

/* Gate 5's own tokeniser, copied from scripts/checks/provenance.mjs:49 rather
   than approximated with /\d/. The lookbehind and lookahead are what let a
   dataset slug through: in `olmo3.1-32b-kl0.0-seed2` every digit is adjacent to
   a word character or a hyphen, so the gate sees no number and neither does
   this. A blunter test would refuse the subject name, which is a third-party
   artifact identifier and not a claim about the world. */
const NUMERIC = /(?<![\w.-])[+-]?\d[\d,]*(?:\.\d+)?(?:\s?%|×|x)?(?![\w-])/;

interface Props {
  items: MetaItem[];
  class?: string;
}

const { items, class: extraClass = "" } = Astro.props as Props;

if (!items.length) {
  throw new Error(
    "act-meta: no items. An empty margin column is a reserved gutter, which " +
      "DESIGN.md §7.1 does not describe. Omit the margin slot instead.",
  );
}

for (const item of items) {
  if (
    item.value !== null &&
    NUMERIC.test(String(item.value)) &&
    !item.source
  ) {
    throw new Error(
      `act-meta: "${item.label}" renders "${String(item.value)}", which carries ` +
        `a numeral and no source. Gate 5 walks every text node in dist/ and a ` +
        `margin is not exempt. Pass the item's source, or move the number into ` +
        `the body where it can be chipped.`,
    );
  }
}
---

<dl class:list={["act-meta", "type-mono-sm", extraClass]}>
  {
    items.map((item) => (
      <div class="act-meta__row">
        <dt class="act-meta__label">{item.label}</dt>
        <dd class="act-meta__value">
          {item.value === null ? (
            ui.no_value
          ) : item.source ? (
            <ActSource
              display={String(item.value)}
              document={item.source.document}
              line={item.source.line}
              label={item.label}
            />
          ) : (
            item.value
          )}
        </dd>
      </div>
    ))
  }
</dl>

<style>
  .act-meta {
    margin: 0;
    min-width: 0;
    /* Below --bp-md: a wrapped row above the content, left-aligned, label and
       value side by side. specimen-390.png. */
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
  }

  .act-meta__row {
    display: flex;
    gap: var(--space-2);
    min-width: 0;
  }

  .act-meta__label {
    margin: 0;
    color: var(--ink-2);
  }

  .act-meta__value {
    margin: 0;
    color: var(--ink-3);
    overflow-wrap: anywhere;
  }

  @media (min-width: 47.5rem) /* --bp-md */ {
    /* The margin column proper: stacked pairs, right-aligned against the
       body's left edge, label above value. specimen-1440.png. */
    .act-meta {
      display: block;
      text-align: end;
    }

    .act-meta__row {
      display: block;
      margin-block-end: var(--space-4);
    }

    .act-meta__row:last-of-type {
      margin-block-end: 0;
    }
  }
</style>
