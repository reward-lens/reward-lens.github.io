---
/**
 * act-figure-detectors  ·  Fig. 2.3, the tradeoff in one frame
 *
 * pages/see-run.md:97: "the four detectors' lead against their surrogate rate
 * as a scatter, with the shipped signal marked. This is the figure that makes
 * the tradeoff visible in one frame and it is the one most likely to be
 * screenshotted, so it must be legible frozen and carry its full caption."
 *
 * THE PROBLEM THE PAGE FILE DID NOT KNOW ABOUT, and how it is solved rather
 * than hidden. Two of the four detectors have only one of the two coordinates.
 * `gradient_norm_cusum` has a surrogate rate and no lead, because it never
 * alarmed; `gradient_norm_peak` has a lead and no surrogate rate, because the
 * surrogate arm was not run on it. A scatter drops both. Dropping half the
 * study's detectors to make a cleaner picture is the exact selection this act
 * argues against, so a detector with a missing coordinate is drawn ON THE RAIL
 * at that axis's margin, hollow, with the null marker in its label. The reader
 * sees four detectors and sees which two are incomplete, which is more than a
 * two-point scatter would have told them.
 *
 * THE TABLE BENEATH IS NOT A FALLBACK. components/before-after.md criterion 5:
 * a comparison whose numbers exist only as bar lengths is not available to a
 * screen reader, and the table is the same data rather than a summary of it. It
 * is also the "detector table" pages/see-run.md asks part 4 for, and rendering
 * it inside the frame rather than beside it keeps one left edge and one order.
 *
 * ROW ORDER IS THE STUDY'S. Never sorted by lead descending
 * (components/timeline-scrubber.md, Usage, "Incorrect"). Same rule as the
 * selector in part 3, and the two must agree or the reader sees two orderings
 * of one set.
 *
 * EVERY NUMBER CARRIES ITS SOURCE. Act two's numbers have no evidence record
 * and never will (C-34, D-35), so they cite a document and a line at the weight
 * a provenance chip gets.
 */
import ActSource from "@components/acts/act-source.astro";
import { ui } from "../../copy";
import type { Detector } from "@components/islands/timeline-scrubber.astro";

interface Props {
  detectors: Detector[];
  /** Humanised field names. Same set the scrubber uses, so the two agree. */
  labels: {
    detector: string;
    lead: string;
    surrogate: string;
    shipped: string;
  };
  class?: string;
}

const { detectors, labels, class: extraClass = "" } = Astro.props;

const leads = detectors.map((d) => d.leadWidths).filter((v): v is number => v !== null);
const rates = detectors.map((d) => d.surrogateRate).filter((v): v is number => v !== null);
if (!leads.length || !rates.length) {
  throw new Error(
    "act-figure-detectors: neither axis has a measured value. The figure is a " +
      "tradeoff between two quantities and it does not render one of them alone.",
  );
}

/* The axes are derived from both series together and never per point, which is
   components/before-after.md's one layout rule: a comparison drawn at two
   scales is not a comparison. Zero is on both axes because a lead of zero and a
   false-alarm rate of zero are both meaningful, and a rebased axis is the
   oldest chart lie there is. */
const leadMin = Math.min(0, ...leads);
const leadMax = Math.max(0, ...leads);
const rateMax = Math.max(...rates);

const W = 1000;
const H = 460;
// Left padding holds the rail and the "not measured" label that names it, which
// is the longest string on the axis.
const PAD_L = 210;
const PAD_R = 40;
const PAD_T = 26;
const PAD_B = 78;
const plotW = W - PAD_L - PAD_R;
const plotH = H - PAD_T - PAD_B;

// The rails sit outside the data area, one per axis, for a detector missing
// that coordinate. RAIL is the offset from the axis origin into the margin.
const RAIL = 46;

const padLead = (leadMax - leadMin) * 0.12 || 1;
const lo = leadMin - padLead;
const hi = leadMax + padLead;
const rateHi = Math.max(rateMax * 1.15, 0.1);

const xr = (rate: number) => PAD_L + (rate / rateHi) * plotW;
const yl = (lead: number) => PAD_T + (1 - (lead - lo) / (hi - lo)) * plotH;
const xRail = PAD_L - RAIL;
const yRail = PAD_T + plotH + RAIL;

const zeroY = yl(0);

const fmtPct = (v: number) => `${(v * 100).toFixed(1)}%`;
const fmtLead = (v: number) => (v > 0 ? `+${v}` : String(v));

/* A label anchored to the right of a mark in the right third of the frame runs
   off the viewBox and the SVG clips it, which is how a four-point figure loses
   the name of its worst detector. Past two thirds the label flips to the left
   of its mark. Nothing else about the mark changes. */
const FLIP_AT = PAD_L + plotW * (2 / 3);

const points = detectors.map((d) => {
  const cx = d.surrogateRate === null ? xRail : xr(d.surrogateRate);
  return {
    d,
    cx,
    cy: d.leadWidths === null ? yRail : yl(d.leadWidths),
    complete: d.surrogateRate !== null && d.leadWidths !== null,
    flip: cx > FLIP_AT,
  };
});

// The accessible name states what the figure shows, both axes and the marked
// point, not "a chart showing a comparison".
const alt = points
  .map(
    (p) =>
      `${p.d.label}: ${labels.lead} ${p.d.leadWidths === null ? ui.no_value : fmtLead(p.d.leadWidths)}, ` +
      `${labels.surrogate} ${p.d.surrogateRate === null ? ui.no_value : fmtPct(p.d.surrogateRate)}` +
      `${p.d.shipped ? `, ${labels.shipped}` : ""}`,
  )
  .join(". ");

const tableId = "fig-detectors-table";
---

<div class:list={["fd", extraClass]}>
  <svg viewBox={`0 0 ${W} ${H}`} class="fd__svg" role="img" aria-label={alt} aria-describedby={tableId}>
    {/* The zero lead line. Above it a detector leads the labelled transition,
        below it a detector lags: the sign is the reading, and it is drawn. */}
    <line class="fd__axis" x1={PAD_L} x2={PAD_L + plotW} y1={zeroY} y2={zeroY} />
    <line class="fd__axis fd__axis--frame" x1={PAD_L} x2={PAD_L} y1={PAD_T} y2={PAD_T + plotH} />

    {/* The two rails, one per axis, for a detector whose coordinate on that
        axis was not measured. Dashed, so a mark on a rail cannot be misread as
        a measurement at zero. */}
    <line class="fd__rail" x1={xRail} x2={xRail} y1={PAD_T} y2={PAD_T + plotH} />
    <line class="fd__rail" x1={PAD_L} x2={PAD_L + plotW} y1={yRail} y2={yRail} />

    {/* THE AXES ARE NAMED, NOT TICKED, and that is deliberate rather than
        lazy. A tick label is a number, and an axis maximum is a number this
        component computed rather than a number anybody measured: gate 5 read
        the padded maximum "79.7%" as an unbound claim, and it was right to.
        Every value on this figure is in the table beneath it, cited, and the
        axes carry the two quantity names instead. Nothing is lost: a reader
        reads magnitudes off the marks and values off the table. */}
    {/* Both axis names anchored at the frame's left edge, one under the
        horizontal axis and one above the vertical one. Anchoring the vertical
        name to the end of the zero line ran it off the left of the viewBox and
        the SVG clipped it, which is a figure losing the name of the quantity it
        is about. */}
    <text class="fd__tick type-mono-sm" x={xRail} y={PAD_T + plotH + 46} text-anchor="start">
      {labels.surrogate}
    </text>
    <text class="fd__tick type-mono-sm" x={xRail} y={PAD_T - 8} text-anchor="start">
      {labels.lead}
    </text>
    {/* The rails are labelled with copy.yaml's own words rather than with a
        dash, because a dash on an axis is a tick and this is not one. */}
    <text class="fd__tick fd__tick--rail type-mono-sm" x={xRail - 8} y={PAD_T + plotH / 2} text-anchor="end">
      {ui.no_value}
    </text>
    <text class="fd__tick fd__tick--rail type-mono-sm" x={PAD_L + plotW} y={yRail + 22} text-anchor="end">
      {ui.no_value}
    </text>

    {
      points.map((p) => (
        <>
          <circle
            class:list={[
              "fd__pt",
              p.d.shipped && "fd__pt--shipped",
              !p.complete && "fd__pt--partial",
            ]}
            cx={p.cx}
            cy={p.cy}
            r={p.d.shipped ? 11 : 8}
            data-detector={p.d.key}
          />
          <text
            class:list={["fd__name", "type-mono-sm", p.d.shipped && "fd__name--shipped"]}
            x={p.flip ? p.cx - 18 : p.cx + 18}
            y={p.cy + 5}
            text-anchor={p.flip ? "end" : "start"}
          >
            {p.d.label}
          </text>
        </>
      ))
    }
  </svg>

  {/* The same data, keyboard reachable, every number carrying its citation. */}
  <div class="fd__scroll" role="group" aria-labelledby={`${tableId}-cap`} tabindex="0">
    <table class="fd__table" id={tableId}>
      <caption class="fd__caption type-mono-label" id={`${tableId}-cap`}>
        {`${labels.lead} · ${labels.surrogate}`}
      </caption>
      <thead>
        <tr>
          <th class="fd__th type-mono-label" scope="col">{labels.detector}</th>
          <th class="fd__th type-mono-label" scope="col" data-align="end">{labels.lead}</th>
          <th class="fd__th type-mono-label" scope="col" data-align="end">{labels.surrogate}</th>
        </tr>
      </thead>
      <tbody>
        {
          detectors.map((d) => (
            <tr class:list={["fd__tr", d.shipped && "fd__tr--shipped"]}>
              <th class="fd__td fd__td--name type-body-sm" scope="row">
                {d.label}
                {d.shipped && (
                  <span class="fd__flag type-mono-label"> {labels.shipped}</span>
                )}
              </th>
              <td class="fd__td type-mono-base" data-align="end">
                {d.leadWidths === null ? (
                  <>
                    <span aria-hidden="true">—</span>
                    <span class="visually-hidden">{ui.no_value}</span>
                  </>
                ) : (
                  <ActSource
                    display={fmtLead(d.leadWidths)}
                    document={d.source.document}
                    line={d.source.line}
                    label={`${labels.lead}, ${d.label}`}
                  />
                )}
              </td>
              <td class="fd__td type-mono-base" data-align="end">
                {d.surrogateRate === null ? (
                  <>
                    <span aria-hidden="true">—</span>
                    <span class="visually-hidden">{ui.no_value}</span>
                  </>
                ) : (
                  <ActSource
                    display={fmtPct(d.surrogateRate)}
                    document={d.source.document}
                    line={d.source.line}
                    label={`${labels.surrogate}, ${d.label}`}
                  />
                )}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</div>

<style>
  .fd {
    min-width: 0;
    display: grid;
    gap: var(--space-5);
  }

  .fd__svg {
    inline-size: 100%;
    block-size: auto;
    display: block;
  }

  /* A DIFFERENT COMPOSITION AT 390, NOT A SCALED ONE. GROUND-TRUTH.md C-8
     records this as a live defect in the design's own specimen: the same figure
     scaled to 350px renders its labels at about four pixels and is unreadable.
     The scatter's viewBox is 1000 units wide, so every label shrinks with it:
     1,216px of grid at 1440 renders them at about 16px, 1,024 at 13, and 768 at
     nine. Below --bp-lg the marks come out and the table stays, which is the
     same data in the composition that survives the width. Nothing is lost,
     because the table was never a summary of the figure. */
  @media (max-width: 63.9375rem) /* --bp-lg */ {
    .fd__svg {
      display: none;
    }
  }

  .fd__axis {
    stroke: var(--line-strong);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }

  .fd__rail {
    stroke: var(--line);
    stroke-width: 1.5;
    stroke-dasharray: 4 5;
    vector-effect: non-scaling-stroke;
  }

  /* The type role arrives as a class on the <text> node, per D-28. Only the
     fill is set here, because fill is not something a role class carries. */
  .fd__tick,
  .fd__name {
    fill: var(--ink-2);
  }

  .fd__name--shipped {
    fill: var(--ink);
  }

  /* Sign and identity, never hue for decoration. The shipped signal is the one
     the study kept, so it is filled and larger; the rest are hollow. A detector
     with an unmeasured coordinate is hollow AND dashed, which is a third state
     carried by shape rather than by a third colour. */
  .fd__pt {
    fill: none;
    stroke: var(--ink-2);
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
  }

  .fd__pt--shipped {
    fill: var(--beam);
    stroke: var(--beam);
  }

  .fd__pt--partial {
    stroke-dasharray: 3 3;
  }

  /* --- the table --- */
  .fd__scroll {
    min-width: 0;
    overflow-x: auto;
  }
  .fd__scroll:focus-visible {
    outline: var(--focus-width) solid var(--focus);
    outline-offset: var(--focus-offset);
  }

  .fd__table {
    border-collapse: collapse;
    inline-size: max-content;
    min-inline-size: 100%;
    text-align: start;
  }

  .fd__caption {
    caption-side: top;
    text-align: start;
    color: var(--ink-2);
    padding-block-end: var(--space-3);
  }

  .fd__th,
  .fd__td {
    padding: var(--space-3) var(--space-4);
    border-block-end: var(--border-w) solid var(--line);
    vertical-align: baseline;
    text-align: start;
    min-width: 0;
  }

  .fd__th {
    color: var(--ink-2);
    font-weight: inherit;
    white-space: nowrap;
  }

  .fd__td {
    color: var(--ink);
  }

  .fd__td--name {
    font-weight: inherit;
  }

  .fd__th[data-align="end"],
  .fd__td[data-align="end"] {
    text-align: end;
  }

  .fd__tr--shipped {
    background: var(--surface-1);
  }

  .fd__flag {
    color: var(--ink-2);
  }
</style>
