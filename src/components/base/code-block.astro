---
/**
 * code-block  ·  design/components/code-block.md
 *
 * Code a reader could run, copyable without ceremony, with its real printed
 * output beside it rather than described in prose. A printed result is
 * evidence; a description of one is not. That is why the output pane is part
 * of this component and not a sibling of it.
 *
 * THE BLOCK NEVER WRAPS CODE. It scrolls horizontally inside itself. Wrapped
 * code is unreadable and misleads about line length. The scroll region carries
 * role="group", tabindex="0" and an accessible name, because a horizontally
 * scrollable <pre> with no tabindex is one no keyboard user can scroll, and
 * then the code is present and unreadable. It is a group and not a region: a
 * region is a landmark, and a documentation page with thirty blocks would emit
 * thirty identically named landmarks and make the rotor useless.
 *
 * Gutter annotations rather than comments inside the snippet: a comment gets
 * copied along with the code and then lives in someone's file saying things
 * that were true on a website. At most three, because past three the reader is
 * reading the margin instead of the code and the snippet should be shorter.
 *
 * Syntax colour is the one bounded relaxation of the site's colour rule.
 * Shiki's two high-contrast themes are already contrast-checked and are not
 * the site's data palette; re-mapping them onto six component tokens would
 * make code look like a decomposition chart. Gate 15 permits colour literals
 * inside Shiki's generated output and nowhere else in this implementation.
 */
import { Code } from "astro:components";
import { ui } from "../../copy";
import { fill, uniqueId } from "./data";

interface Annotation {
  line: number;
  text: string;
}

interface Props {
  /** From a generated file or the content collection. Never inline in a page. */
  code: string;
  lang?: string;
  /** The real printed output. Diffed against CI execution when verified. */
  output?: string | null;
  /** true means CI runs this snippet and compares `output`. Gate 3. */
  verified?: boolean;
  annotations?: Annotation[];
  copyable?: boolean;
  /** Replaces `lang` in the head bar when the snippet is a file. */
  filename?: string | null;
  /**
   * What names the snippet inside `copy.yaml:ui.code_region_aria`. The sentence
   * is copy's; this is the data that goes in it, and it falls back to the
   * filename or the language, which are data too.
   */
  label?: string | null;
  class?: string;
}

const {
  code,
  lang = "python",
  output = null,
  verified = false,
  annotations = [],
  copyable = true,
  filename = null,
  label = null,
  class: extraClass = "",
} = Astro.props;

if (typeof code !== "string" || code.trim() === "") {
  throw new Error(
    `code-block: empty code. components/code-block.md: "a block with empty code fails ` +
      `the build".`,
  );
}
if (annotations.length > 3) {
  throw new Error(
    `code-block: ${annotations.length} gutter annotations on the ${filename ?? lang} ` +
      `block. components/code-block.md permits at most three; beyond three the reader is ` +
      `reading the margin rather than the code and the snippet should be shorter.`,
  );
}

const head = filename ?? lang;
// A byte count is not an identity: two python blocks of the same length on
// one page collided, and the second block's copy confirmation was announced
// through the first block's live region.
const uid = uniqueId(
  `cb-${head.replace(/[^a-z0-9]/gi, "-").toLowerCase()}-${code.length}`,
  Astro.url.pathname,
);
const liveId = `${uid}-live`;
const regionAria = fill(ui.code_region_aria, { name: label ?? head });
---

<div
  class:list={["cb", extraClass]}
  data-verified={verified ? "true" : undefined}
  data-code-block
>
  <div class="cb__head">
    <span class="cb__lang type-mono-label" id={`${uid}-head`}>{head}</span>
    {
      copyable && (
        <button
          type="button"
          class="cb__copy type-mono-label"
          data-cb-copy
          data-code={code}
          data-announce={ui.code_copied_label}
          data-live-target={liveId}
          aria-label={ui.copy_code_aria}
        >
          <span class="cb__copy-swap">
            <span class="cb__copy-label" data-label="idle">
              {ui.code_copy_label}
            </span>
            <span class="cb__copy-label" data-label="done">
              {ui.code_copied_label}
            </span>
          </span>
        </button>
      )
    }
  </div>

  <div class="cb__panes">
    <div class="cb__body">
      <div
        class="cb__scroll"
        role="group"
        tabindex="0"
        aria-label={regionAria}
      >
        <Code
          code={code}
          lang={lang as never}
          themes={{
            light: "github-light-high-contrast",
            dark: "github-dark-high-contrast",
          }}
          defaultColor="light"
        />
      </div>
      {
        annotations.length > 0 && (
          <div class="cb__gutter">
            {annotations.map((a) => (
              <span
                class="cb__note type-mono-sm"
                id={`${uid}-note-${a.line}`}
                data-line={a.line}
                style={`--cb-line:${a.line}`}
              >
                {a.text}
              </span>
            ))}
          </div>
        )
      }
    </div>

    {
      output !== null && output !== "" && (
        <div class="cb__output">
          <p class="cb__output-label type-mono-label" id={`${uid}-out`}>{ui.code_output_label}</p>
          {/* Named by the two labels already on screen, so a reader who lands
              in this scroll region hears "Output, <the block's head>" and not a
              second region with the same name as the code pane. Focusability is
              set by the script below, and only where the pane really scrolls. */}
          <pre
            class="cb__output-body type-mono-sm"
            aria-labelledby={`${uid}-out ${uid}-head`}>{output}</pre>
        </div>
      )
    }
  </div>

  {copyable && <span class="visually-hidden" id={liveId} aria-live="polite" />}
</div>

<script>
  // 1400ms, from components/code-block.md: the copy label swaps to `copied` for
  // 1400ms and then reverts. Same dwell as the install strip, and the same
  // reason it is not a --dur token.
  const REVERT_AFTER = 1400;

  for (const button of document.querySelectorAll<HTMLButtonElement>(
    "[data-cb-copy]",
  )) {
    const live = document.getElementById(button.dataset.liveTarget ?? "");
    const block = button.closest<HTMLElement>("[data-code-block]");
    const canCopy = Boolean(navigator.clipboard?.writeText);
    let timer: number | undefined;

    if (!canCopy) {
      // The control becomes a select-all affordance. No error is shown.
      button.dataset.state = "manual";
    }

    button.addEventListener("click", async () => {
      const code = block?.querySelector("pre code");
      if (!canCopy) {
        if (!code) return;
        const range = document.createRange();
        range.selectNodeContents(code);
        const sel = window.getSelection();
        sel?.removeAllRanges();
        sel?.addRange(range);
        return;
      }
      try {
        // Exactly the code: no prompt glyph, no annotation text, no line
        // numbers and no trailing whitespace.
        await navigator.clipboard.writeText(button.dataset.code ?? "");
      } catch {
        return;
      }
      button.dataset.state = "done";
      if (live) live.textContent = button.dataset.announce ?? "";
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        delete button.dataset.state;
        if (live) live.textContent = "";
      }, REVERT_AFTER);
    });
  }

  // The output pane is a scroll region too, and it was not a reachable one.
  //
  // The code pane carries role/tabindex/aria-label in the template because it
  // ALWAYS scrolls: `inline-size: max-content` guarantees it. The output pane
  // does not — most outputs are a few short lines — so declaring it focusable
  // in the template would put a spurious tab stop on every block with output
  // across a hundred documentation pages. It is measured instead, which is the
  // same thing `Docs.astro` does for display mathematics and wide tables.
  //
  // /start/ carried this as a page script with a comment saying the component
  // should own it. It does now; that script is redundant and its page can drop
  // it. Applying it twice is harmless, so the two can land in either order.
  //
  // setAttribute rather than `el.tabIndex = 0`: the docs packet lost an
  // afternoon to that, because tabIndex is a property of HTMLElement and
  // SVGElement and the assignment fails silently on anything else.
  for (const pane of document.querySelectorAll<HTMLElement>(
    "[data-code-block] .cb__output-body",
  )) {
    if (pane.scrollWidth <= pane.clientWidth) continue;
    pane.setAttribute("role", "group");
    pane.setAttribute("tabindex", "0");
  }

  // A gutter annotation is associated with its line, not left to proximity.
  // The line spans are Shiki's, so the association is made here rather than in
  // the template.
  for (const block of document.querySelectorAll<HTMLElement>("[data-code-block]")) {
    const lines = block.querySelectorAll<HTMLElement>("pre code .line");
    for (const note of block.querySelectorAll<HTMLElement>(".cb__note")) {
      const n = Number(note.dataset.line);
      const line = lines[n - 1];
      if (line && note.id) line.setAttribute("aria-describedby", note.id);
    }
  }
</script>

<style>
  .cb {
    min-width: 0;
    background: var(--code-bg);
    /* --surface-1 declares its elevation as a border and no shadow
       (DESIGN.md §8), and --code-bg is --surface-1 in the dark theme. This is
       the same border F1 gave .astro-code in global.css. */
    border: var(--border-w) solid var(--line);
    border-radius: var(--radius-2);
    overflow: hidden;
  }

  /* --- head bar --- */
  .cb__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-width: 0;
    padding: var(--space-2) var(--space-4);
    background: var(--surface-2);
    border-block-end: var(--border-w) solid var(--line);
    color: var(--ink-2);
  }
  .cb__lang {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .cb__copy {
    display: inline-flex;
    align-items: center;
    /* WCAG 2.2 AA 2.5.8 wants 24x24. The mono-label role's line box plus
       --space-1 of padding lands at 21, three short, on every control on this
       site drawn to this pattern. --space-5 IS 24px, so the floor is a token
       and not a literal, and the padding still decides the width. */
    min-block-size: var(--space-5);
    justify-content: center;
    flex: none;
    color: var(--ink-2);
    background: transparent;
    border: var(--border-w) solid var(--line-control);
    border-radius: var(--radius-1);
    padding: var(--space-1) var(--space-2);
    cursor: pointer;
    transition:
      color var(--dur-1) var(--curve-ui),
      border-color var(--dur-1) var(--curve-ui);
  }
  .cb__copy:hover {
    color: var(--ink);
    border-color: var(--focus);
  }
  .cb__copy:focus-visible {
    outline: var(--focus-width) solid var(--focus);
    outline-offset: var(--focus-offset);
  }
  /* Both labels share one grid cell so the control keeps a fixed width and the
     head bar does not reflow when the label changes. */
  .cb__copy-swap {
    display: grid;
    align-items: center;
    justify-items: center;
  }
  .cb__copy-label {
    grid-area: 1 / 1;
    white-space: nowrap;
  }
  .cb__copy-label[data-label="done"] {
    visibility: hidden;
    color: var(--beam);
  }
  .cb__copy[data-state="done"] .cb__copy-label[data-label="idle"] {
    visibility: hidden;
  }
  .cb__copy[data-state="done"] .cb__copy-label[data-label="done"] {
    visibility: visible;
  }
  :global(:root:not([data-js])) .cb__copy {
    display: none;
  }

  /* --- panes: code beside output at --bp-lg and above --- */
  .cb__panes {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    min-width: 0;
  }
  .cb__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    min-width: 0;
  }

  .cb__scroll {
    overflow-x: auto;
    min-width: 0;
  }
  .cb__scroll:focus-visible {
    outline: var(--focus-width) solid var(--focus);
    outline-offset: calc(-1 * var(--focus-offset));
  }

  /* The block's own frame provides the border and the radius; Shiki's <pre>
     keeps its background and its type role and gives up the rest. Its
     background carries !important in global.css and is left alone. */
  .cb__scroll :global(pre.astro-code) {
    margin: 0;
    border: 0;
    border-radius: 0;
    padding: var(--space-4);
    overflow-x: visible;
    inline-size: max-content;
    min-inline-size: 100%;
  }

  /* --- gutter annotations ---
     Positioned against their line from the mono-base role's own metrics, which
     is what global.css sets on .astro-code, so the note lands on the line it
     annotates rather than near it. */
  .cb__gutter {
    position: relative;
    min-width: 0;
  }
  .cb__note {
    /* ink3-ok: the notes sit on --code-bg, which is --surface-1 in dark
       (4.85:1) and --surface-2 in light (4.60:1). Both clear AA-body. */
    color: var(--ink-3); /* ink3-ok: on --code-bg, 4.85:1 dark and 4.60:1 light */
    display: block;
    min-width: 0;
  }

  @media (min-width: 47.5rem) /* --bp-md */ {
    .cb__body {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    /* The gutter needs a reserved width. Every note in it is absolutely
       positioned, so without a minimum the column collapses to its padding,
       `max-inline-size: 100%` resolves against those few pixels, and the note
       overflows out of the block and is cut off by its overflow: hidden. That
       is what "no GPU" did at 768 before this rule. */
    .cb__gutter {
      min-inline-size: var(--space-9);
      padding-inline-end: var(--space-4);
    }
    .cb__note {
      position: absolute;
      inset-inline-end: var(--space-4);
      inline-size: max-content;
      max-inline-size: calc(100% - var(--space-4));
      top: calc(
        var(--space-4) + var(--type-mono-base-size) * var(--type-mono-base-lh) *
          (var(--cb-line) - 1)
      );
    }
  }

  /* Below --bp-md the annotations move beneath the code, prefixed with a rule.
     They are never hidden. */
  @media (max-width: 47.4375rem) /* --bp-md */ {
    .cb__gutter {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      padding: var(--space-3) var(--space-4);
      border-block-start: var(--border-w) solid var(--line);
    }
    .cb__note {
      border-inline-start: var(--border-w) solid var(--line-strong);
      padding-inline-start: var(--space-3);
    }
  }

  /* --- output pane --- */
  .cb__output {
    min-width: 0;
    padding: var(--space-3) var(--space-4) var(--space-4);
    border-block-start: var(--border-w) solid var(--line);
  }
  .cb__output-label {
    color: var(--ink-2);
    margin: 0 0 var(--space-2);
  }
  .cb__output-body {
    color: var(--ink);
    margin: 0;
    overflow-x: auto;
    white-space: pre;
    min-width: 0;
  }

  @media (min-width: 64rem) /* --bp-lg */ {
    .cb__panes {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
    .cb__output {
      border-block-start: 0;
      border-inline-start: var(--border-w) solid var(--line);
    }
  }

  @media print {
    .cb__scroll {
      overflow-x: visible;
    }
  }
</style>
