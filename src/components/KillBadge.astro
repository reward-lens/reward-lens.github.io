---
// RETIRED, AND NOT IMPORTED BY ANYTHING. Nothing in src/ renders this, so it
// reaches no page and appears in no gate report.
//
// Two reasons it must not be picked up as-is. It builds `K-<name>` and puts it
// in the reader's face, and `K-*` is one of the ~620 identifier families D-05
// bans from rendered HTML, so the first page that uses this fails gate 7 on its
// own output. And the thing it announces is the campaign's pre-registration
// apparatus, which the public vocabulary replaces with the outcome: the result
// contradicted the prediction. A badge saying which mechanism fired is the
// process, and the outcome is the part a reader can act on.
//
// Left in the tree rather than deleted, because deleting one of a pair of
// similarly named components is how a route nobody was looking at stops
// building. Its disposition is a deletion, once someone has checked that no
// branch still under construction imports it.

interface Props {
  kill: string;
}

const { kill } = Astro.props;
const name = kill.startsWith("K-") ? kill : `K-${kill}`;
---

<span class="kill" title={`${name} fired`}>
  <span class="kill-dot" aria-hidden="true"></span>
  <span class="kill-id">{name}</span>
  <span class="kill-state">fired</span>
</span>

<style>
  .kill {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-1);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.2;
    padding: 2px var(--sp-2);
    border: 1px solid color-mix(in oklab, var(--bad) 60%, transparent);
    border-radius: var(--r-chip);
    background: color-mix(in oklab, var(--bad) 12%, transparent);
    color: var(--bad-ink);
    white-space: nowrap;
    vertical-align: baseline;
    letter-spacing: 0.01em;
  }
  .kill-dot {
    width: 5px;
    height: 5px;
    border-radius: var(--r-pill);
    background: var(--bad);
    flex: none;
  }
  .kill-id {
    font-weight: 500;
  }
  .kill-state {
    text-transform: uppercase;
    font-size: 0.85em;
    letter-spacing: 0.06em;
    color: color-mix(in oklab, var(--bad-ink) 80%, var(--ink-3));
  }
</style>
