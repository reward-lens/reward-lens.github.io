{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "scene.manifest",
 "title": "The scene truth manifest",
 "description": "Generated by scripts/build_scene_data.mjs. One entry per case, where a case is one subject shown in one of the instrument's five states. The generator enforces more than this schema can state, in particular that a schematic case carries no quantitative encoding and that every encoding names an array the payload actually holds. This file exists so a hand-edited manifest is caught as well as a mis-generated one.",
 "type": "object",
 "additionalProperties": false,
 "required": ["version", "generatedBy", "generatedAt", "cases"],
 "properties": {
  "version": { "type": "integer", "minimum": 1 },
  "generatedBy": { "const": "scripts/build_scene_data.mjs" },
  "generatedAt": { "type": "string", "format": "date-time" },
  "cases": { "type": "array", "minItems": 5, "items": { "$ref": "#/$defs/case" } }
 },
 "$defs": {
  "case": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "id",
    "state",
    "plateKind",
    "publicLabel",
    "truthMode",
    "subject",
    "source",
    "scope",
    "caveat",
    "encodings",
    "contentHash"
   ],
   "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "state": { "enum": ["scorer", "selection", "update", "response", "run-boundary"] },
    "plateKind": { "type": "string", "pattern": "^[A-Z][A-Z -]+$" },
    "publicLabel": { "type": "string", "minLength": 8 },
    "truthMode": { "enum": ["schematic", "measured", "derived", "bounded"] },
    "subject": { "type": "string", "minLength": 20 },
    "source": { "$ref": "#/$defs/source" },
    "scope": { "type": "string", "minLength": 20 },
    "caveat": { "type": "string", "minLength": 20 },
    "encodings": { "type": "array", "items": { "$ref": "#/$defs/encoding" } },
    "contentHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
   }
  },
  "source": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "repositoryPath": { "type": "string", "pattern": "^[^/]" },
    "publicUrl": { "type": "string", "format": "uri" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "artifact": { "type": "string", "minLength": 8 }
   }
  },
  "encoding": {
   "type": "object",
   "additionalProperties": false,
   "required": ["visualProperty", "quantity", "transform", "unit", "domain", "clamp"],
   "properties": {
    "visualProperty": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*(\\.[a-zA-Z0-9]+)+$" },
    "quantity": { "type": "string", "minLength": 1 },
    "transform": { "type": "string", "minLength": 40 },
    "unit": { "type": ["string", "null"] },
    "domain": { "type": ["array", "null"], "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
    "clamp": { "type": "boolean" },
    "downsample": { "$ref": "#/$defs/downsample" }
   }
  },
  "downsample": {
   "type": "object",
   "additionalProperties": false,
   "required": ["method", "seed", "inputCount", "outputCount"],
   "properties": {
    "method": { "type": "string", "minLength": 40 },
    "seed": { "type": "integer", "minimum": 0 },
    "inputCount": { "type": "integer", "minimum": 1 },
    "outputCount": { "type": "integer", "minimum": 1 }
   }
  }
 }
}
