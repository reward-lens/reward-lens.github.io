    "reward_lens.studies.spec.Prediction": {
      "path": "reward_lens.studies.spec.Prediction",
      "name": "Prediction",
      "kind": "class",
      "text": "A registered, checkable prediction (R12).\n\n``metric`` names the quantity the analysis will compute; ``comparator`` and ``threshold`` state\nthe predicted relationship (for example ``metric=\"spearman_chi_vs_drift\", comparator=\">\",\nthreshold=0.3``). ``effect`` and ``ci_excludes`` optionally register a point effect size and a\nvalue the CI should exclude. This is what makes a claim uneditable after seeing the data: the\nprediction is hashed into the frozen study.",
      "params": [],
      "returns": [],
      "raises": [],
      "examples": [],
