    "reward_lens.studies.runner.run_study": {
      "path": "reward_lens.studies.runner.run_study",
      "name": "run_study",
      "kind": "function",
      "text": "Run a study end to end: freeze if needed, execute the analysis, adjudicate against the spec.\n\nThe study must be frozen before it runs (a spec is frozen here if a raw spec was passed, so the\nfreeze provably predates the evidence). The analysis function (resolved from the spec's dotted\npath, or supplied directly for tests) computes the metrics its predictions named. The runner\nthen checks each hypothesis's prediction and each kill criterion against those metrics, sets the\noutcomes, and returns the StudyResult with its adjudicating evidence ids attached. Refutations\nand fired kill criteria are recorded as prominently as confirmations (I4).",
      "params": [],
      "returns": [],
      "raises": [],
      "examples": [],
      "admonitions": [],
      "source": {
        "file": "src/reward_lens/studies/runner.py",
        "start": 90,
        "end": 136,
        "url": "https://github.com/reward-lens/reward-lens/blob/bceb2986ab54a9fcd8d39e3550f4b089e90cd7d6/src/reward_lens/studies/runner.py#L90-L136"
      },
      "signature": "run_study(\n    spec_or_frozen: StudySpec | FrozenStudy,\n    *,\n    subjects: dict[str, Any] | None = None,\n    store: EvidenceStore | None = None,\n    analysis_fn: Callable[[StudyRun], StudyResult] | None = None\n) -> tuple[FrozenStudy, StudyResult]",
      "bases": null,
