{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reward-lens.github.io/schemas/release.schema.json",
  "title": "Release state",
  "description": "Public reward-lens release state. A 3.1.0 finalization requires the qualified CI RELEASE_ARTIFACTS.json manifest, successful public CI run and matching source tree, PyPI metadata and downloaded distribution SHA-256 values.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "latest",
    "unpublished",
    "requiresPython",
    "releases",
    "urls",
    "fetchedAt"
  ],
  "properties": {
    "latest": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Newest public PyPI version. The release finalizer verifies this against the qualified CI artifact manifest and downloaded distribution hashes."
    },
    "unpublished": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([a-z]+[0-9]+)?$",
      "description": "A tree version that is ahead of PyPI, or null for a finalized public release. The 3.1.0 finalizer requires null."
    },
    "unpublishedIsAhead": {
      "type": "boolean",
      "description": "True only when an unpublished version is ahead of the public package index."
    },
    "requiresPython": {
      "type": "string"
    },
    "releases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "uploadedAt"
        ],
        "properties": {
          "version": {
            "type": "string"
          },
          "uploadedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "urls": {
      "type": "object",
      "description": "Public package metadata URLs and their canonical site/repository targets.",
      "additionalProperties": false,
      "required": [
        "publishedHomepage",
        "publishedDocumentation",
        "canonicalRepo",
        "canonicalDocs"
      ],
      "properties": {
        "publishedHomepage": {
          "type": "string",
          "format": "uri"
        },
        "publishedDocumentation": {
          "type": "string",
          "format": "uri"
        },
        "canonicalRepo": {
          "type": "string",
          "format": "uri"
        },
        "canonicalDocs": {
          "type": "string",
          "format": "uri"
        },
        "publishedUrlsAreStale": {
          "type": "boolean",
          "description": "True when published metadata differs from the canonical repository or documentation URL."
        }
      }
    },
    "changelogUrl": {
      "type": "string",
      "format": "uri"
    },
    "fetchedAt": {
      "type": "string",
      "format": "date-time"
    },
    "artifactBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "sourceSha",
        "sourceTree",
        "ciRunId",
        "sha256"
      ],
      "properties": {
        "repository": {
          "const": "reward-lens/reward-lens"
        },
        "sourceSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "sourceTree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "ciRunId": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reward_lens-3.1.0-py3-none-any.whl",
            "reward_lens-3.1.0.tar.gz"
          ],
          "properties": {
            "reward_lens-3.1.0-py3-none-any.whl": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "reward_lens-3.1.0.tar.gz": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    }
  }
}
