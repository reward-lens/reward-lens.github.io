{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reward-lens.github.io/schemas/catalogue.schema.json",
  "title": "Instrument catalogue",
  "description": "Every instrument the library registers, by series, read from the live registry through reward_lens.access.report.load_instrument_catalogue() and cross-checked against spec/CATALOGUE.json. Generated by scripts/build_catalogue.py. Transcribed from nothing: a page cannot say the catalogue holds 89 instruments while the catalogue holds 95. If the library will not import, the build fails; there is no vendored copy. Consumed by the atlas and catalogue routes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "counts",
    "series",
    "instruments",
    "provenance"
  ],
  "properties": {
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instruments",
        "wedge",
        "series",
        "scheduled"
      ],
      "description": "Derived from the arrays below, never carried separately. A count that disagrees with its own array is the defect this file exists to make impossible.",
      "properties": {
        "instruments": {
          "type": "integer",
          "minimum": 1
        },
        "wedge": {
          "type": "integer",
          "minimum": 0
        },
        "series": {
          "type": "integer",
          "minimum": 1
        },
        "scheduled": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "series": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "letter",
          "title",
          "instruments"
        ],
        "properties": {
          "letter": {
            "type": "string",
            "pattern": "^[A-Z]$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "instruments": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "instruments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "series",
          "name",
          "quantities",
          "substrates",
          "phases",
          "wedge",
          "ladder"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][0-9]{1,2}$",
            "description": "An internal identifier, and therefore banned from user-facing prose (HANDOFF.md rule 3). Permitted here and on the catalogue route itself, where the identifier is the subject rather than jargon standing in for one."
          },
          "series": {
            "type": "string",
            "pattern": "^[A-Z]$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "headline": {
            "type": [
              "string",
              "null"
            ]
          },
          "quantities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "headlineQuantity": {
            "type": [
              "string",
              "null"
            ]
          },
          "accessMin": {
            "type": [
              "string",
              "null"
            ]
          },
          "substrates": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "phases": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "In declaration order, which for Phase is the order a run passes through. Not sorted alphabetically: PRE_RUN before POST_RUN is information."
          },
          "invarianceGroup": {
            "type": [
              "string",
              "null"
            ]
          },
          "wedge": {
            "type": "boolean"
          },
          "status": {
            "type": [
              "string",
              "null"
            ]
          },
          "workPackage": {
            "type": [
              "string",
              "null"
            ],
            "description": "Null means not scheduled. Also an internal identifier; the same rule as id."
          },
          "envelope": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "requires",
              "measuredBy",
              "unconditionalJustification"
            ],
            "description": "An empty requires with a justification is an unconditional instrument. An empty requires with no justification means the catalogue says OPEN, which is an absence and renders as one.",
            "properties": {
              "requires": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "measuredBy": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "unconditionalJustification": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "ladder": {
            "type": "array",
            "description": "Rungs in the order the catalogue declares them, cheapest and most biased first.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "rung",
                "estimator",
                "access",
                "bias",
                "cost"
              ],
              "properties": {
                "rung": {
                  "type": "integer",
                  "minimum": 0
                },
                "estimator": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "access": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "bias": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "cost": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "baselines": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "killCondition": {
            "type": [
              "string",
              "null"
            ]
          },
          "says": {
            "type": [
              "string",
              "null"
            ],
            "description": "What a reading would say. A specimen sentence, not a measurement, and it must never be rendered as one."
          },
          "priorArt": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generatedBy",
        "libraryVersion",
        "librarySource",
        "quantitySource",
        "skippedModules"
      ],
      "description": "Which library this was read from. A libraryVersion below 3.0.0 means the generator ran under the wrong venv and every count is a v2 count; build_catalogue.py refuses that case rather than emitting it. skippedModules names the modules a missing optional extra kept out of the walk, and it is not decoration: an estimator registers when its module imports, so a skipped module makes its quantities read as open. A reader who is told which extras were missing can tell 'nobody has built this' from 'this build could not see it'.",
      "properties": {
        "generatedBy": {
          "const": "scripts/build_catalogue.py"
        },
        "libraryVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+"
        },
        "librarySource": {
          "type": "string"
        },
        "quantitySource": {
          "type": "string"
        },
        "skippedModules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
