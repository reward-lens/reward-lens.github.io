{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reward-lens.github.io/schemas/cards.schema.json",
  "title": "Campaign cards",
  "description": "One entry per frozen study card: its hypotheses, its verdict, the kill that fired, and the freeze that predates the run. Generated by scripts/build_data.py. `frozen_at` and `spec_hash` are the load-bearing fields: they are what makes a registered prediction registered, and a card rendered without them is a result with no claim to having been predicted in advance.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "card",
      "title",
      "verdict",
      "hypotheses",
      "adjudication_ev",
      "frozen_at",
      "spec_hash",
      "study_id",
      "figure"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "card": {
        "type": "string"
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "science": {
        "type": [
          "string",
          "null"
        ]
      },
      "science_name": {
        "type": [
          "string",
          "null"
        ]
      },
      "science_raw": {
        "type": [
          "string",
          "null"
        ]
      },
      "verdict": {
        "enum": [
          "confirmed",
          "refuted",
          "mixed",
          "inconclusive"
        ]
      },
      "kill_fired": {
        "type": [
          "string",
          "null"
        ]
      },
      "kill_note": {
        "type": [
          "string",
          "null"
        ],
        "description": "Verbatim from RESULTS.md, parsed and never re-written: the project's own sentence about its own kill is sharper than a paraphrase."
      },
      "kill_criteria": {
        "type": "array",
        "items": {
          "type": "object"
        }
      },
      "hypotheses": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "statement",
            "metric",
            "comparator",
            "threshold",
            "observed",
            "outcome"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "statement": {
              "type": "string"
            },
            "metric": {
              "type": "string"
            },
            "comparator": {
              "type": "string"
            },
            "threshold": {
              "type": [
                "number",
                "string",
                "null"
              ]
            },
            "ci_excludes": {
              "type": [
                "number",
                "string",
                "boolean",
                "null"
              ]
            },
            "registered_prob": {
              "type": [
                "number",
                "null"
              ]
            },
            "interval_prediction": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "observed": {
              "type": [
                "number",
                "null"
              ]
            },
            "outcome": {
              "type": "string"
            },
            "scoreboard_row": {
              "type": [
                "string",
                "number",
                "null"
              ]
            }
          }
        }
      },
      "adjudication_ev": {
        "type": "string",
        "pattern": "^ev:[0-9a-f]{32}$"
      },
      "adjudicated_at": {
        "type": "string"
      },
      "frozen_at": {
        "type": "string"
      },
      "spec_hash": {
        "type": "string"
      },
      "spec_file": {
        "type": "string"
      },
      "study_id": {
        "type": "string"
      },
      "figure": {
        "type": "string"
      },
      "caption": {
        "type": [
          "string",
          "object",
          "null"
        ]
      },
      "power_acceptance": {
        "type": [
          "object",
          "null"
        ],
        "additionalProperties": false,
        "description": "Non-null on the eight cards where the power to detect the registered effect was accepted in advance. Null elsewhere, and its absence is not a small thing: an unpowered null cannot be told from a real one.",
        "required": [
          "power",
          "mde",
          "note"
        ],
        "properties": {
          "power": {
            "type": "number"
          },
          "mde": {
            "type": [
              "number",
              "null"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      },
      "inconclusive_reason": {
        "type": [
          "string",
          "null"
        ]
      },
      "companion_metrics": {
        "type": "object"
      },
      "subjects": {
        "type": "object"
      }
    }
  }
}
