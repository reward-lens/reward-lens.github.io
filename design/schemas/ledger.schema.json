{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reward-lens.github.io/schemas/ledger.schema.json",
  "title": "Prediction ledger",
  "description": "One row per registered hypothesis, with what was predicted, what was observed and whether a kill fired. Generated by scripts/build_data.py from the frozen specs and the adjudication records. `observed` is null on an inconclusive row and that is not a missing value: the card did not adjudicate, so there is no observation, and a dash is the honest cell.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "card",
      "slug",
      "hypothesis_id",
      "statement",
      "metric",
      "comparator",
      "threshold",
      "observed",
      "outcome",
      "science"
    ],
    "properties": {
      "card": {
        "type": "string"
      },
      "slug": {
        "type": "string"
      },
      "hypothesis_id": {
        "type": "string"
      },
      "statement": {
        "type": "string",
        "minLength": 1
      },
      "metric": {
        "type": "string"
      },
      "comparator": {
        "type": "string"
      },
      "threshold": {
        "type": [
          "number",
          "string",
          "null"
        ]
      },
      "registered_prob": {
        "type": [
          "number",
          "null"
        ],
        "description": "The probability registered BEFORE the run. Null where none was registered, and never back-filled."
      },
      "interval_prediction": {
        "type": [
          "boolean",
          "null"
        ]
      },
      "observed": {
        "type": [
          "number",
          "null"
        ]
      },
      "outcome": {
        "enum": [
          "confirmed",
          "refuted",
          "inconclusive"
        ]
      },
      "kill_id": {
        "type": [
          "string",
          "null"
        ]
      },
      "inconclusive_reason": {
        "type": [
          "string",
          "null"
        ],
        "description": "Why the card did not adjudicate. Present on every inconclusive row and shown, because an unexplained inconclusive reads as a hidden failure."
      },
      "science": {
        "type": [
          "string",
          "null"
        ]
      }
    }
  }
}
