{
  "name": "reward-lens-site",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "build:data": "python scripts/build_data.py",
    "check": "node scripts/checks/data_assertions.mjs && astro check && node scripts/checks/links.mjs && node scripts/checks/copy_grep.mjs && node scripts/checks/redirects.mjs && node scripts/checks/meta_audit.mjs && bash scripts/checks/claims_gate.sh",
    "check:claims": "bash scripts/checks/claims_gate.sh"
  },
  "description": "The reward-lens website: campaign ledger, atlas, docs, science.",
  "dependencies": {
    "@astrojs/mdx": "^4.3.14",
    "@astrojs/react": "^4.4.2",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^5.18.2",
    "katex": "^0.18.1",
    "pagefind": "^1.5.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "playwright": "^1.61.1",
    "typescript": "^5.9.3"
  },
  "private": true
}
