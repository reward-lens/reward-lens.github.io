{
  "name": "reward-lens-site",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "build:data": "${PYTHON:-python3} scripts/build_data.py",
    "build:catalogue": "${PYTHON:-python3} scripts/build_catalogue.py",
    "build:intervention": "${PYTHON:-python3} scripts/build_intervention.py",
    "build:grader-cards": "${PYTHON:-python3} scripts/build_grader_cards.py",
    "build:bundles": "${PYTHON:-python3} scripts/build_bundles.py",
    "build:scene-data": "node scripts/build_scene_data.mjs",
    "gen:release": "node scripts/gen-release.mjs",
    "gen:release:check": "node scripts/gen-release.mjs --check",
    "test:regression": "node --test tests/regression/",
    "check": "node scripts/checks/paths.mjs && node scripts/build_scene_data.mjs --check && node scripts/checks/data_assertions.mjs && astro check && node scripts/checks/links.mjs && node scripts/checks/copy_grep.mjs && node scripts/checks/redirects.mjs && node scripts/checks/meta_audit.mjs && bash scripts/checks/claims_gate.sh && node scripts/checks/terms.mjs && node scripts/checks/claims-public.mjs",
    "check:claims": "bash scripts/checks/claims_gate.sh",
    "check:paths": "node scripts/checks/paths.mjs",
    "film": "node film/scripts/render.mjs",
    "tokens:py": "node scripts/gen-tokens-py.mjs",
    "tokens:py:check": "node scripts/gen-tokens-py.mjs --check",
    "lint:tokens": "node scripts/lint-tokens.mjs",
    "shoot": "node scripts/dev/shoot.mjs",
    "check:terms": "node scripts/checks/terms.mjs",
    "check:terms:selftest": "node scripts/checks/terms.mjs --self-test",
    "test:terms": "node --test tests/regression/terms-gate.test.mjs",
    "build:claims": "node scripts/build_claims.mjs",
    "check:claims-public": "node scripts/build_claims.mjs --check && node scripts/checks/claims-public.mjs",
    "check:scene-runtime": "node scripts/checks/scene-runtime.mjs",
    "test:scene": "node --test tests/scene/",
    "check:banned": "node scripts/checks/banned.mjs",
    "test:banned": "node --test tests/regression/banned-gate.test.mjs",
    "build:atlas": "node scripts/build_atlas.mjs",
    "build:atlas:check": "node scripts/build_atlas.mjs --check",
    "test:atlas": "node --test tests/regression/atlas-data.test.mjs",
    "perf:gpu-memory": "node tests/perf/gpu-memory.mjs",
    "perf:network": "node tests/perf/network.mjs",
    "perf:runtime": "node tests/perf/runtime.mjs",
    "perf:aa-ab": "node tests/perf/aa-ab.mjs",
    "perf:bundle": "node tests/perf/bundle-attribution.mjs",
    "perf:collate": "node tests/perf/collate.mjs",
    "perf:gate-violations": "node tests/perf/gate-violations.mjs",
    "check:budgets": "node scripts/checks/budgets.mjs",
    "check:frames": "node scripts/checks/frames.mjs",
    "build:scene-stills": "node scripts/dev/build-scene-stills.mjs",
    "build:scene-stills:check": "node scripts/dev/build-scene-stills.mjs --check",
    "check:fidelity": "node scripts/checks/fidelity.mjs",
    "shoot:fallback": "node tests/scene/fallback/_shoot.mjs",
    "build:noscene": "PUBLIC_SCENE=off astro build --outDir dist-noscene",
    "check:noscene": "bash scripts/checks/no-scene-build.sh"
  },
  "description": "The reward-lens website: campaign ledger, atlas, docs, science.",
  "dependencies": {
    "@astrojs/mdx": "^4.3.14",
    "@astrojs/react": "^4.4.2",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@react-three/fiber": "^9.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^5.18.2",
    "katex": "^0.18.1",
    "pagefind": "^1.5.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.0",
    "axe-core": "^4.12.1",
    "playwright": "^1.61.1",
    "typescript": "^5.9.3",
    "yaml": "^2.9.0"
  },
  "private": true
}
